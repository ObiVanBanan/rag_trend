# Fully local evaluation profile for rag_tender.
# Copy to .env only for the local campaign; keep the cloud profile separately.

APP_ENV=local
LOG_LEVEL=INFO

# Local Qdrant. Use a separate collection because vector dimension/model differ
# from the cloud OpenAI index.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=steel_products_local_qwen3_06b
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_TIMEOUT_SECONDS=10

# Ollama embeddings: Qwen3-Embedding-0.6B outputs 1024-dimensional vectors.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
DENSE_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_SLEEP_SECONDS=0.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=180

# OpenAI settings are unused by the local embedding backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=10

# LM Studio exposes an OpenAI-compatible chat endpoint.
# Replace DEEPSEEK_MODEL with the exact identifier shown by GET /v1/models.
DEEPSEEK_API_KEY=lm-studio
DEEPSEEK_BASE_URL=http://localhost:1234/v1
DEEPSEEK_MODEL=REPLACE_WITH_LM_STUDIO_MODEL_ID
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_SEND_THINKING_CONTROL=false

QUERY_INTERPRETER_ENABLED=true
QUERY_INTERPRETER_SYSTEM_PROMPT_PATH=src/nomenclature_matcher/prompts/query_interpreter_system.md
RERANKER_SYSTEM_PROMPT_PATH=src/nomenclature_matcher/prompts/reranker_system.md

# Keep Campaign 4 local/deterministic: no external web dependency.
WEB_SEARCH_ENABLED=false
COMPETITOR_LOOKUP_ENABLED=false

HYBRID_DENSE_LIMIT=50
HYBRID_BM25_LIMIT=50
HYBRID_RERANK_LIMIT=20
RRF_K=60
RERANK_CANDIDATE_LIMIT=20
RERANK_RESULT_LIMIT=3
MATCH_TOP_K=20
MATCH_SCORE_THRESHOLD=0.0

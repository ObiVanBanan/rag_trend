OPENAI_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
DENSE_BATCH_SIZE=32
MATCH_TOP_K=5
MATCH_SCORE_THRESHOLD=0.0


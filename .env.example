APP_ENV=development
LOG_LEVEL=INFO

# Production API
API_HOST=0.0.0.0
API_PORT=8000
API_MAX_BATCH_SIZE=100
PRODUCT_CSV_PATH=ld_products_full_nomenclature.csv
DATABASE_URL=postgresql://rag_tender:rag_tender@localhost:5432/rag_tender
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
MATCH_TRACE_ENABLED=true
OUTBOUND_PROXY_URL=
OBSERVABILITY_NETWORK=rag-observability-net
POSTGRES_DB=rag_tender
POSTGRES_USER=rag_tender
POSTGRES_PASSWORD=rag_tender

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=steel_products_active
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_TIMEOUT_SECONDS=5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
QUERY_INTERPRETER_ENABLED=true
QUERY_INTERPRETER_SYSTEM_PROMPT_PATH=src/nomenclature_matcher/prompts/query_interpreter_system.md

WEB_SEARCH_ENABLED=true
WEB_SEARCH_MCP_COMMAND=uvx
WEB_SEARCH_MCP_PACKAGE=duckduckgo-mcp-server[browser]
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_FETCH_PAGES=3
WEB_SEARCH_FETCH_CHARS=5000
WEB_SEARCH_TIMEOUT_SECONDS=45
WEB_SEARCH_REGION=wt-wt

COMPETITOR_LOOKUP_ENABLED=false
COMPETITOR_LOOKUP_LIMIT=3
COMPETITOR_LOOKUP_PRELIMIT=200
COMPETITOR_LOOKUP_MIN_CONFIDENCE=0.84
COMPETITOR_LOOKUP_MIN_SCORE_MARGIN=8

RERANKER_SYSTEM_PROMPT_PATH=src/nomenclature_matcher/prompts/reranker_system.md
HYBRID_DENSE_LIMIT=50
HYBRID_BM25_LIMIT=50
HYBRID_RERANK_LIMIT=20
RRF_K=60
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
DENSE_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_SLEEP_SECONDS=0.25
RERANK_CANDIDATE_LIMIT=20
RERANK_RESULT_LIMIT=3
MATCH_TOP_K=5
MATCH_SCORE_THRESHOLD=0.0

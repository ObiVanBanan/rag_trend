+
+
+def test_actuator_ready_ball_valve_adds_state_specific_control_vocabulary():
+    result = canonicalize_retrieval_query("Кран шаровой муфтовый Ду25 Ру16 под электропривод")
+
+    assert result.source_query == "Кран шаровой муфтовый Ду25 Ру16 под электропривод"
+    assert result.canonical_query == (
+        "Кран шаровой муфтовый DN 25 PN 16 под электропривод Управление: Под электропривод"
+    )
+
+
+def test_actuation_intent_preserves_connection_and_technical_constraints():
+    result = canonicalize_retrieval_query("Кран шаровой WW Ду100 Ру25 под электропривод")
+
+    assert result.canonical_query == (
+        "Кран шаровой WW приварной под приварку сварной DN 100 PN 25 под электропривод "
+        "Управление: Под электропривод"
+    )
+
+
+def test_actuation_intent_abstains_for_non_ball_valves_and_negation():
+    assert "Управление:" not in (
+        canonicalize_retrieval_query("Клапан DN50 PN16 с электроприводом").canonical_query or ""
+    )
+    assert "Управление:" not in (
+        canonicalize_retrieval_query("Кран шаровой DN50 PN16 без электропривода").canonical_query or ""
+    )
+
+
+def test_actuation_intent_abstains_for_conflicting_generic_and_abbreviated_drive_terms():
+    cases = [
+        "Кран шаровой DN50 PN16 с электроприводом под электропривод",

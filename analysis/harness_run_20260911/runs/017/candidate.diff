+)
+_INSTALLED_ELECTRIC_RE = re.compile(
+    r"\b(?:"
+    r"с\s+электроприводом|"
+    r"со\s+встроенным\s+электроприводом|"
+    r"с\s+установленным\s+электроприводом|"
+    r"электропривод\s+установлен\w*"
+    r")\b",

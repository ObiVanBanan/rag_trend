 _STANDALONE_WW_RE = re.compile(r"(?<![A-Za-zА-Яа-яЁё0-9])WW(?![A-Za-zА-Яа-яЁё0-9])", re.IGNORECASE)
+_BALL_VALVE_RE = re.compile(r"\b(?:кран\s+шаровой|шаровой\s+кран)\b", re.IGNORECASE)
+_ACTUATION_NEGATION_RE = re.compile(
+    r"\b(?:без|не|нет|исключая)\s+(?:\S+\s+){0,3}?(?:электропривод\w*|электро\s*привод\w*|привод\w*)\b",

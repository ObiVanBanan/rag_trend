+        "Кран шаровой DN50 PN16 эл. прив.",
+        "Кран шаровой DN50 PN16 электропривод",
+    ]
+    for query in cases:
+        assert "Управление:" not in (canonicalize_retrieval_query(query).canonical_query or "")


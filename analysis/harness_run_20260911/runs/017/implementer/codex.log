+def _classify_ball_valve_actuation_intent(text: str) -> str | None:
+    if not _BALL_VALVE_RE.search(text) or _ACTUATION_NEGATION_RE.search(text):
+        return None
+    has_installed = _INSTALLED_ELECTRIC_RE.search(text) is not None
+    has_ready = _ACTUATOR_READY_RE.search(text) is not None
+    if has_installed == has_ready:
+        return None
+    return "installed" if has_installed else "ready"
+
+
+def _append_actuation_intent_alternate(text: str, intent: str | None) -> str:
+    if intent == "installed":
+        return _cleanup_spacing(f"{text} Управление: Электропривод")
+    if intent == "ready":
+        return _cleanup_spacing(f"{text} Управление: Под электропривод")
+    return text
+
+
 def _normalize_designation_confusables(text: str) -> str:
     def replace(match: re.Match[str]) -> str:
         token = match.group(0)

+from .query_constraints import (
+    candidate_bore_type,
+    candidate_control,
+    candidate_dn,
+    candidate_joining_type,
+    candidate_material,
+    candidate_pn_mpa,
+    candidate_product_type,
+    candidate_valve_type,
+)
+
+
+UNKNOWN = "__unknown__"
+
+
+@dataclass(frozen=True)
+class StructuralSignature:
+    product_type: str
+    dn: int
+    pn_mpa: float
+    joining_type: str
+    execution: str
+    control: str
+    material: str
+    bore: str
+
+
+def structural_signature(candidate: SearchCandidate) -> StructuralSignature | None:
+    """Return a reliable catalog-observable signature, or None to fail open."""
+    product = _candidate_as_product(candidate)
+    product_type = candidate_product_type(product)
+    dn = candidate_dn(product)
+    pn_mpa = candidate_pn_mpa(product)
+
+    if product_type == "other" or dn is None or pn_mpa is None:
+        return None
+
+    return StructuralSignature(
+        product_type=product_type,
+        dn=dn,
+        pn_mpa=round(pn_mpa, 6),
+        joining_type=candidate_joining_type(product) or UNKNOWN,
+        execution=candidate_valve_type(product) or UNKNOWN,
+        control=candidate_control(product) or UNKNOWN,
+        material=candidate_material(product) or UNKNOWN,
+        bore=candidate_bore_type(product) or UNKNOWN,
+    )
+
+
+def diversify_candidates(candidates: list[SearchCandidate], limit: int) -> list[SearchCandidate]:
+    if limit <= 0:
+        return []
+    if len(candidates) <= limit:
+        return candidates
+
+    retained: list[SearchCandidate] = []
+    retained_ids: set[int] = set()
+    seen_signatures: set[StructuralSignature] = set()
+    deferred_duplicates: list[SearchCandidate] = []
+
+    for candidate in candidates:
+        signature = structural_signature(candidate)
+        if signature is None:
+            retained.append(candidate)
+            retained_ids.add(candidate.ld_id)
+        elif signature not in seen_signatures:
+            seen_signatures.add(signature)
+            retained.append(candidate)
+            retained_ids.add(candidate.ld_id)
+        else:
+            deferred_duplicates.append(candidate)
+        if len(retained) == limit:
+            return retained
+
+    for candidate in deferred_duplicates:
+        if candidate.ld_id in retained_ids:
+            continue
+        retained.append(candidate)
+        if len(retained) == limit:
+            break
+
+    return retained
+
+
+def _candidate_as_product(candidate: SearchCandidate) -> LDProduct:
+    return LDProduct(
+        id=candidate.ld_id,
+        name=candidate.name,
+        article=candidate.article,
+        price=candidate.price,
+        dn=candidate.dn,
+        pn=candidate.pn,
+        joining_type=candidate.joining_type,
+        url=candidate.url,
+        properties=_properties_or_empty(candidate.properties),
+    )
+
+
+def _properties_or_empty(properties: Any) -> list[dict[str, Any]]:
+    return properties if isinstance(properties, list) else []

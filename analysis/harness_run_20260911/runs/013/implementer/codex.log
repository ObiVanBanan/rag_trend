+
+def test_diversify_candidates_fills_remaining_slots_with_duplicates_in_rrf_order():
+    duplicate_1 = candidate(1)
+    duplicate_2 = candidate(2)
+    distinct = candidate(3, name="Кран шаровой стальной DN80 PN16 приварной ручной")
+    duplicate_3 = candidate(4)
+    duplicate_4 = candidate(5)
+
+    result = diversify_candidates([duplicate_1, duplicate_2, distinct, duplicate_3, duplicate_4], limit=4)
+
+    assert [item.ld_id for item in result] == [1, 3, 2, 4]
+
+
+def test_diversify_candidates_preserves_pool_that_already_fits_limit():
+    candidates = [candidate(1), candidate(2)]
+
+    assert diversify_candidates(candidates, limit=2) is candidates
+
+
+def test_diversify_candidates_keeps_incomplete_metadata_in_rank_order():
+    incomplete = candidate(1, dn=None)
+    duplicate_1 = candidate(2)
+    duplicate_2 = candidate(3)
+
+    result = diversify_candidates([incomplete, duplicate_1, duplicate_2], limit=2)
+
+    assert [item.ld_id for item in result] == [1, 2]

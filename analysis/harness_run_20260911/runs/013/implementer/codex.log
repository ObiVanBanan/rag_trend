+def test_hybrid_search_diversifies_after_rrf_and_preserves_scores_and_limit():
+    settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=3, rrf_k=60)
+    retriever = HybridRetriever(Embedder(), DiversifiedQdrantStore(), DiversifiedBM25Store(), settings)
+
+    results = retriever.search("query")
+
+    assert [candidate.ld_id for candidate in results] == [1, 3, 4]
+    assert len(results) == 3
+    assert results[0].retrieval_sources == ["dense", "bm25"]
+    assert results[0].rrf_score == (1 / 61) + (1 / 61)
+    assert results[0].score == results[0].rrf_score
+
+
 def test_hybrid_search_retrieves_alternate_only_when_distinct():
     settings = SimpleNamespace(hybrid_dense_limit=7, hybrid_bm25_limit=8, hybrid_rerank_limit=20, rrf_k=60)

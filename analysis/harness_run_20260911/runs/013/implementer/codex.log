+from nomenclature_matcher.candidate_diversification import (
+    UNKNOWN,
+    StructuralSignature,
+    diversify_candidates,
+    structural_signature,
+)
+from nomenclature_matcher.models import SearchCandidate
+
+
+def candidate(
+    ld_id: int,
+    *,
+    name: str = "Кран шаровой стальной подземный DN80 PN16 фланцевый полнопроходной ручной",
+    dn: object = 80,
+    pn: object = 16,
+    joining_type: str | None = "фланцевое",
+    properties: list[dict[str, object]] | None = None,
+) -> SearchCandidate:
+    return SearchCandidate(
+        ld_id=ld_id,
+        name=name,
+        article=f"A{ld_id}",
+        score=1.0 / ld_id,
+        dn=dn,
+        pn=pn,
+        joining_type=joining_type,
+        properties=properties,
+        rrf_score=1.0 / ld_id,
+    )
+
+
+def test_structural_signature_covers_core_observable_fields():
+    signature = structural_signature(candidate(1))
+
+    assert signature == StructuralSignature(
+        product_type="ball_valve",
+        dn=80,
+        pn_mpa=1.6,
+        joining_type="flanged",
+        execution="underground",
+        control="manual",
+        material="steel",
+        bore="full",
+    )
+
+
+def test_structural_signature_distinguishes_control_material_bore_and_execution():
+    base = structural_signature(candidate(1))
+    electric = structural_signature(candidate(2, name="Кран шаровой стальной под электропривод DN80 PN16 фланцевый"))
+    brass = structural_signature(candidate(3, name="Кран шаровой латунный DN80 PN16 фланцевый ручной"))
+    reduced = structural_signature(candidate(4, name="Кран шаровой стальной DN80 PN16 фланцевый редуцированный ручной"))
+    standard = structural_signature(candidate(5, name="Кран шаровой стальной DN80 PN16 фланцевый ручной"))
+
+    assert electric != base
+    assert brass != base
+    assert reduced != base
+    assert standard != base
+
+
+def test_structural_signature_uses_properties_for_dn_pn_connection_material_bore_control():
+    signature = structural_signature(
+        candidate(
+            1,
+            name="Кран шаровой",
+            dn=None,
+            pn=None,
+            joining_type=None,
+            properties=[
+                {"name": "Номинальный диаметр, DN", "values": ["DN 50"]},
+                {"name": "Номинальное давление, МПа", "values": ["1,6"]},
+                {"name": "Присоединение", "values": ["под приварку"]},
+                {"name": "Материал корпуса", "values": ["латунь"]},
+                {"name": "Тип прохода", "values": ["полнопроходной"]},
+                {"name": "Управление", "values": ["электропривод"]},
+            ],
+        )
+    )
+
+    assert signature is not None
+    assert signature.dn == 50
+    assert signature.pn_mpa == 1.6
+    assert signature.joining_type == "welded"
+    assert signature.material == "brass"
+    assert signature.bore == "full"
+    assert signature.control == "electric"
+
+
+def test_structural_signature_fails_open_for_missing_or_malformed_core_metadata():
+    assert structural_signature(candidate(1, dn=None)) is None
+    assert structural_signature(candidate(2, pn="PN без числа")) is None
+    assert structural_signature(candidate(3, name="Изделие DN80 PN16")) is None
+
+
+def test_structural_signature_keeps_unknown_optional_values_distinguishable():
+    signature = structural_signature(candidate(1, name="Кран шаровой DN80 PN16 фланцевый"))
+
+    assert signature is not None
+    assert signature.material == UNKNOWN
+    assert signature.bore == UNKNOWN
+
+
+def test_diversify_candidates_defers_duplicate_specialised_variants_for_later_distinct_candidate():
+    duplicate_1 = candidate(1)
+    duplicate_2 = candidate(2)
+    distinct = candidate(3, name="Кран шаровой стальной DN80 PN16 фланцевый ручной")
+
+    result = diversify_candidates([duplicate_1, duplicate_2, distinct], limit=2)
+
+    assert [item.ld_id for item in result] == [1, 3]
+
+
+def test_diversify_candidates_fills_remaining_slots_with_duplicates_in_rrf_order():
+    duplicate_1 = candidate(1)
+    duplicate_2 = candidate(2)
+    distinct = candidate(3, name="Кран шаровой стальной DN80 PN16 приварной ручной")
+    duplicate_3 = candidate(4)
+    duplicate_4 = candidate(5)
+
+    result = diversify_candidates([duplicate_1, duplicate_2, distinct, duplicate_3, duplicate_4], limit=4)
+
+    assert [item.ld_id for item in result] == [1, 3, 2, 4]
+
+
+def test_diversify_candidates_preserves_pool_that_already_fits_limit():
+    candidates = [candidate(1), candidate(2)]
+
+    assert diversify_candidates(candidates, limit=2) is candidates
+
+
+def test_diversify_candidates_keeps_incomplete_metadata_in_rank_order():
+    incomplete = candidate(1, dn=None)
+    duplicate_1 = candidate(2)
+    duplicate_2 = candidate(3)
+
+    result = diversify_candidates([incomplete, duplicate_1, duplicate_2], limit=2)
+
+    assert [item.ld_id for item in result] == [1, 2]

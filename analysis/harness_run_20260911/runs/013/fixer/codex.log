+def _material_grade_evidence(product: LDProduct) -> tuple[str, ...]:
+    text = _norm(candidate_material_text(product))
+    if not text:
+        return (UNKNOWN,)
+
+    grades: set[str] = set()
+    for match in re.finditer(r"\b(?:сталь|ст\.?)\s*([0-9]{1,2}[а-я0-9]{0,8})\b", text):
+        grades.add(match.group(1))
+    for match in re.finditer(r"\baisi\s*([0-9]{3}[a-zа-я]?)\b", text):
+        grades.add(f"aisi{match.group(1)}")
+    for match in re.finditer(r"\b[0-9]{2}[а-я][0-9а-я]{1,8}\b", text):
+        grades.add(match.group(0))
+
+    return tuple(sorted(grades)) if grades else (UNKNOWN,)
+

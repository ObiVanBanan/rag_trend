 def _properties_or_empty(properties: Any) -> list[dict[str, Any]]:
     return properties if isinstance(properties, list) else []
+
+
+def _normalized_medium_evidence(product: LDProduct) -> tuple[str, ...]:
+    values = tuple(sorted(set(_medium_values(product))))
+    return values if values else (UNKNOWN,)
+
+
+def _material_grade_evidence(product: LDProduct) -> tuple[str, ...]:
+    text = _norm(candidate_material_text(product))
+    if not text:
+        return (UNKNOWN,)
+
+    grades: set[str] = set()
+    for match in re.finditer(r"\b(?:сталь|ст\.?)\s*([0-9]{1,2}[а-я0-9]{0,8})\b", text):
+        grades.add(match.group(1))
+    for match in re.finditer(r"\baisi\s*([0-9]{3}[a-zа-я]?)\b", text):
+        grades.add(f"aisi{match.group(1)}")
+    for match in re.finditer(r"\b[0-9]{2}[а-я][0-9а-я]{1,8}\b", text):
+        grades.add(match.group(0))
+
+    return tuple(sorted(grades)) if grades else (UNKNOWN,)
+
+
+def _designation_evidence(product: LDProduct) -> tuple[str, ...]:
+    compact_parts = [product.article or ""]
+    token_parts = [product.name]
+    for prop in product.properties or []:
+        if _norm(prop.get("name")) in {"серия", "тип продукта", "тип продукта ai"}:
+            compact_parts.extend(_flatten_values(prop.get("values")))
+
+    tokens: set[str] = set()
+    for part in compact_parts:
+        text = _norm(part)
+        compact_text = re.sub(r"[^0-9a-zа-я]+", "", text)
+        if _looks_like_designation(compact_text):
+            tokens.add(compact_text)
+    for part in [*compact_parts, *token_parts]:
+        text = _norm(part)
+        for raw_token in re.findall(r"[0-9a-zа-я][0-9a-zа-я./-]{2,}[0-9a-zа-я]", text):
+            token = re.sub(r"[^0-9a-zа-я]+", "", raw_token)
+            if _looks_like_designation(token):
+                tokens.add(token)
+
+    return tuple(sorted(tokens)) if tokens else (UNKNOWN,)
+
+
+def _looks_like_designation(token: str) -> bool:
+    if len(token) < 4:
+        return False
+    if re.fullmatch(r"(?:dn|ду|pn|ру)\d+(?:\d+)?", token):
+        return False
+    has_digit = any(char.isdigit() for char in token)
+    has_alpha = any(char.isalpha() for char in token)
+    if has_digit and has_alpha:
+        return True
+    return token.startswith("кш") and len(token) <= 12
+
+
+def _flatten_values(value: Any) -> list[str]:
+    if value in (None, "", []):
+        return []
+    if isinstance(value, list):
+        result: list[str] = []
+        for item in value:
+            result.extend(_flatten_values(item))
+        return result
+    return [str(value)]

+        text = _norm(part)
+        compact_text = re.sub(r"[^0-9a-zа-я]+", "", text)
+        if _looks_like_designation(compact_text):
+            tokens.add(compact_text)
+        for raw_token in re.findall(r"[0-9a-zа-я][0-9a-zа-я./-]{2,}[0-9a-zа-я]", text):
+            token = re.sub(r"[^0-9a-zа-я]+", "", raw_token)
+            if _looks_like_designation(token):
+                tokens.add(token)
+
+    return tuple(sorted(tokens)) if tokens else (UNKNOWN,)
+
+
+def _looks_like_designation(token: str) -> bool:
+    if len(token) < 4:
+        return False
+    has_digit = any(char.isdigit() for char in token)
+    has_alpha = any(char.isalpha() for char in token)
+    if has_digit and has_alpha:
+        return True
+    return token.startswith("кш") and len(token) <= 12
+

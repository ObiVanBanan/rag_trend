from __future__ import annotations

from dataclasses import dataclass
import re
from typing import Any

from .models import LDProduct, SearchCandidate
from .query_constraints import (
    _medium_values,
    _norm,
    candidate_bore_type,
    candidate_control,
    candidate_dn,
    candidate_joining_type,
    candidate_material,
    candidate_material_text,
    candidate_pn_mpa,
    candidate_product_type,
    candidate_thread_type,
    candidate_valve_type,
)


UNKNOWN = "__unknown__"


@dataclass(frozen=True)
class StructuralSignature:
    product_type: str
    dn: int
    pn_mpa: float
    joining_type: str
    thread_type: str
    working_medium: tuple[str, ...]
    execution: str
    control: str
    material: str
    material_grade: tuple[str, ...]
    bore: str
    designation: tuple[str, ...]


def structural_signature(candidate: SearchCandidate) -> StructuralSignature | None:
    """Return a reliable catalog-observable signature, or None to fail open."""
    product = _candidate_as_product(candidate)
    product_type = candidate_product_type(product)
    dn = candidate_dn(product)
    pn_mpa = candidate_pn_mpa(product)

    if product_type == "other" or dn is None or pn_mpa is None:
        return None

    return StructuralSignature(
        product_type=product_type,
        dn=dn,
        pn_mpa=round(pn_mpa, 6),
        joining_type=candidate_joining_type(product) or UNKNOWN,
        thread_type=candidate_thread_type(product) or UNKNOWN,
        working_medium=_normalized_medium_evidence(product),
        execution=candidate_valve_type(product) or UNKNOWN,
        control=candidate_control(product) or UNKNOWN,
        material=candidate_material(product) or UNKNOWN,
        material_grade=_material_grade_evidence(product),
        bore=candidate_bore_type(product) or UNKNOWN,
        designation=_designation_evidence(product),
    )


def diversify_candidates(candidates: list[SearchCandidate], limit: int) -> list[SearchCandidate]:
    if limit <= 0:
        return []
    if len(candidates) <= limit:
        return candidates

    retained: list[SearchCandidate] = []
    retained_ids: set[int] = set()
    seen_signatures: set[StructuralSignature] = set()
    deferred_duplicates: list[SearchCandidate] = []

    for candidate in candidates:
        signature = structural_signature(candidate)
        if signature is None:
            retained.append(candidate)
            retained_ids.add(candidate.ld_id)
        elif signature not in seen_signatures:
            seen_signatures.add(signature)
            retained.append(candidate)
            retained_ids.add(candidate.ld_id)
        else:
            deferred_duplicates.append(candidate)
        if len(retained) == limit:
            return retained

    for candidate in deferred_duplicates:
        if candidate.ld_id in retained_ids:
            continue
        retained.append(candidate)
        if len(retained) == limit:
            break

    return retained


def _candidate_as_product(candidate: SearchCandidate) -> LDProduct:
    return LDProduct(
        id=candidate.ld_id,
        name=candidate.name,
        article=candidate.article,
        price=candidate.price,
        dn=candidate.dn,
        pn=candidate.pn,
        joining_type=candidate.joining_type,
        url=candidate.url,
        properties=_properties_or_empty(candidate.properties),
    )


def _properties_or_empty(properties: Any) -> list[dict[str, Any]]:
    return properties if isinstance(properties, list) else []


def _normalized_medium_evidence(product: LDProduct) -> tuple[str, ...]:
    values = tuple(sorted(set(_medium_values(product))))
    return values if values else (UNKNOWN,)


def _material_grade_evidence(product: LDProduct) -> tuple[str, ...]:
    text = _norm(candidate_material_text(product))
    if not text:
        return (UNKNOWN,)

    grades: set[str] = set()
    for match in re.finditer(r"\b(?:сталь|ст\.?)\s*([0-9]{1,2}[а-я0-9]{0,8})\b", text):
        grades.add(match.group(1))
    for match in re.finditer(r"\baisi\s*([0-9]{3}[a-zа-я]?)\b", text):
        grades.add(f"aisi{match.group(1)}")
    for match in re.finditer(r"\b[0-9]{2}[а-я][0-9а-я]{1,8}\b", text):
        grades.add(match.group(0))

    return tuple(sorted(grades)) if grades else (UNKNOWN,)


def _designation_evidence(product: LDProduct) -> tuple[str, ...]:
    compact_parts = [product.article or ""]
    token_parts = [product.name]
    for prop in product.properties or []:
        if _norm(prop.get("name")) in {"серия", "тип продукта", "тип продукта ai"}:
            compact_parts.extend(_flatten_values(prop.get("values")))

    tokens: set[str] = set()
    for part in compact_parts:
        text = _norm(part)
        compact_text = re.sub(r"[^0-9a-zа-я]+", "", text)
        if _looks_like_designation(compact_text):
            tokens.add(compact_text)
    for part in [*compact_parts, *token_parts]:
        text = _norm(part)
        for raw_token in re.findall(r"[0-9a-zа-я][0-9a-zа-я./-]{2,}[0-9a-zа-я]", text):
            token = re.sub(r"[^0-9a-zа-я]+", "", raw_token)
            if _looks_like_designation(token):
                tokens.add(token)

    return tuple(sorted(tokens)) if tokens else (UNKNOWN,)


def _looks_like_designation(token: str) -> bool:
    if len(token) < 4:
        return False
    if re.fullmatch(r"(?:dn|ду|pn|ру)\d+(?:\d+)?", token):
        return False
    has_digit = any(char.isdigit() for char in token)
    has_alpha = any(char.isalpha() for char in token)
    if has_digit and has_alpha:
        return True
    return token.startswith("кш") and len(token) <= 12


def _flatten_values(value: Any) -> list[str]:
    if value in (None, "", []):
        return []
    if isinstance(value, list):
        result: list[str] = []
        for item in value:
            result.extend(_flatten_values(item))
        return result
    return [str(value)]


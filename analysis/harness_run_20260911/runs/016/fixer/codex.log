from __future__ import annotations

import re
from dataclasses import dataclass
from typing import Any

from .models import SearchCandidate


_DN_RE = re.compile(r"\b(?:dn|ду|дн)\s*[:=]?\s*(\d{1,4})\b", re.IGNORECASE)
_PN_RE = re.compile(r"\b(?:pn|ру|рn)\s*[:=]?\s*(\d{1,3})\b", re.IGNORECASE)

_FAMILY_MARKERS = (
    ("ball_valve", ("кран шаровой", "шаровой кран", "ball valve")),
    ("gate_valve", ("задвижка", "gate valve")),
    ("butterfly_valve", ("затвор", "butterfly valve")),
    ("check_valve", ("клапан обратный", "обратный клапан", "check valve")),
    ("filter", ("фильтр", "filter")),
)

_BORE_MARKERS = (
    ("full_bore", ("полнопроход", "полн проход", "full bore")),
    ("reduced_bore", ("неполнопроход", "редуцирован", "reduced bore")),
)

_EXECUTION_MARKERS = (
    ("flanged", ("фланцев", " flange", " flanged")),
    ("threaded", ("муфтов", "резьб", " threaded")),
    ("welded", ("привар", "под приварку", "сварн", " weld")),
)

_ACTUATION_MARKERS = (
    ("electric", ("электропривод", "с электроприводом", "electric actuator")),
    ("manual", ("ручн", "рукоят", "manual")),
)


@dataclass(frozen=True)
class StructuralSignature:
    family: str
    dn: str
    pn: str
    joining_type: str
    bore: str | None
    execution: str | None
    actuation: str | None


def structural_signature(candidate: SearchCandidate) -> StructuralSignature | None:
    try:
        text = _candidate_text(candidate)
        family = _single_marker(text, _FAMILY_MARKERS)
        dn = _candidate_number(candidate.dn, text, _DN_RE)
        pn = _candidate_number(candidate.pn, text, _PN_RE)
        joining_type = _normal_joining_type(candidate.joining_type)
        if not family or not dn or not pn or not joining_type:
            return None
        return StructuralSignature(
            family=family,
            dn=dn,
            pn=pn,
            joining_type=joining_type,
            bore=_single_marker(text, _BORE_MARKERS),
            execution=_single_marker(text, _EXECUTION_MARKERS),
            actuation=_single_marker(text, _ACTUATION_MARKERS),
        )
    except Exception:
        return None


def diversify_candidates(candidates: list[SearchCandidate], limit: int) -> list[SearchCandidate]:
    if limit <= 0:
        return []

    ranked = sorted(
        candidates,
        key=lambda candidate: (-(candidate.rrf_score or 0.0), candidate.ld_id),
    )
    selected: list[SearchCandidate] = []
    selected_ids: set[int] = set()
    seen_signatures: set[StructuralSignature] = set()

    for candidate in ranked:
        try:
            signature = structural_signature(candidate)
        except Exception:
            signature = None
        if signature is not None:
            if signature in seen_signatures:
                continue
            seen_signatures.add(signature)
        selected.append(candidate)
        selected_ids.add(candidate.ld_id)
        if len(selected) == limit:
            return selected

    for candidate in ranked:
        if candidate.ld_id in selected_ids:
            continue
        selected.append(candidate)
        selected_ids.add(candidate.ld_id)
        if len(selected) == limit:
            break

    return selected


def _candidate_text(candidate: SearchCandidate) -> str:
    return f"{candidate.name or ''} {candidate.search_text or ''}".casefold()


def _normal_number(value: Any) -> str | None:
    if value is None:
        return None
    text = str(value).strip().replace(",", ".")
    if not text:
        return None
    try:
        number = float(text)
    except ValueError:
        return None
    if number <= 0 or not number.is_integer():
        return None
    return str(int(number))


def _candidate_number(value: Any, text: str, pattern: re.Pattern[str]) -> str | None:
    if value is not None:
        return _normal_number(value)
    return _single_number(text, pattern)


def _single_number(text: str, pattern: re.Pattern[str]) -> str | None:
    values = {match.group(1).lstrip("0") or "0" for match in pattern.finditer(text)}
    if len(values) != 1:
        return None
    value = values.pop()
    return value if value != "0" else None


def _normal_joining_type(value: str | None) -> str | None:
    if not value:
        return None
    text = value.casefold()
    if any(marker in text for marker in ("фланц", "flange")):
        return "flanged"
    if any(marker in text for marker in ("муфт", "резьб", "thread")):
        return "threaded"
    if any(marker in text for marker in ("привар", "свар", "weld")):
        return "welded"
    return None


def _single_marker(text: str, groups: tuple[tuple[str, tuple[str, ...]], ...]) -> str | None:
    matched = {name for name, markers in groups if any(marker in text for marker in markers)}
    if len(matched) != 1:
        return None
    return matched.pop()


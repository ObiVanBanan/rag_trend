from nomenclature_matcher.candidate_diversification import diversify_candidates, structural_signature
from nomenclature_matcher.models import SearchCandidate


def candidate(
    ld_id: int,
    *,
    name: str = "Кран шаровой полнопроходной",
    score: float = 0.01,
    dn=50,
    pn=16,
    joining_type="фланцевое",
    search_text: str = "DN: 50 PN: 16 фланцевый полнопроходной",
) -> SearchCandidate:
    return SearchCandidate(
        ld_id=ld_id,
        name=name,
        article=f"A{ld_id}",
        score=score,
        dn=dn,
        pn=pn,
        joining_type=joining_type,
        search_text=search_text,
        rrf_score=score,
    )


def test_structural_signature_uses_direct_fields_and_bounded_markers():
    signature = structural_signature(candidate(1))

    assert signature is not None
    assert signature.family == "ball_valve"
    assert signature.dn == "50"
    assert signature.pn == "16"
    assert signature.joining_type == "flanged"
    assert signature.bore == "full_bore"


def test_structural_signature_returns_none_for_missing_malformed_or_ambiguous_evidence():
    assert structural_signature(candidate(1, dn=None, search_text="PN: 16 фланцевый")) is None
    assert structural_signature(candidate(2, pn="PN16")) is None
    assert structural_signature(candidate(3, joining_type=None)) is None
    assert structural_signature(
        candidate(4, name="Кран шаровой задвижка", search_text="DN: 50 PN: 16 фланцевый")
    ) is None
    assert structural_signature(candidate(5, dn=None, search_text="DN: 50 DN: 80 PN: 16 фланцевый")) is None


def test_diversify_candidates_keeps_highest_ranked_signature_representative_and_fills_capacity():
    repeated_best = candidate(1, score=0.050)
    repeated_lower = candidate(2, score=0.049)
    distinct = candidate(3, score=0.001, dn=80, search_text="DN: 80 PN: 16 фланцевый полнопроходной")

    diversified = diversify_candidates([repeated_best, repeated_lower, distinct], limit=2)

    assert [item.ld_id for item in diversified] == [1, 3]


def test_diversify_candidates_keeps_ungroupable_candidates_eligible():
    repeated_best = candidate(1, score=0.050)
    repeated_lower = candidate(2, score=0.049)
    ungroupable = candidate(3, score=0.001, dn=None, search_text="PN: 16 фланцевый")

    diversified = diversify_candidates([repeated_best, repeated_lower, ungroupable], limit=2)

    assert [item.ld_id for item in diversified] == [1, 3]


def test_diversify_candidates_preserves_no_duplicate_pool_order_and_tie_key():
    candidates = [
        candidate(3, score=0.02, dn=80, search_text="DN: 80 PN: 16 фланцевый полнопроходной"),
        candidate(1, score=0.03, dn=25, search_text="DN: 25 PN: 16 фланцевый полнопроходной"),
        candidate(2, score=0.03, dn=50, search_text="DN: 50 PN: 16 фланцевый полнопроходной"),
    ]

    diversified = diversify_candidates(candidates, limit=3)

    assert [item.ld_id for item in diversified] == [1, 2, 3]


def test_diversify_candidates_appends_redundant_fillers_when_capacity_remains():
    candidates = [
        candidate(1, score=0.050),
        candidate(2, score=0.049),
        candidate(3, score=0.048),
    ]

    diversified = diversify_candidates(candidates, limit=3)

    assert [item.ld_id for item in diversified] == [1, 2, 3]


+def _semantic_evidence(candidate: SearchCandidate) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    evidence: list[tuple[str, tuple[str, ...]]] = []
+    for prop in candidate.properties or []:
+        name = prop.get("name") if isinstance(prop, dict) else None
+        if not name:
+            continue
+        normal_name = _normalize_text(str(name))
+        if not any(marker in normal_name for marker in _SEMANTIC_PROPERTY_MARKERS):
+            continue
+        values = prop.get("values")
+        if values in (None, "", []):
+            continue
+        if not isinstance(values, list):
+            values = [values]
+        normal_values = tuple(sorted({_normalize_text(str(value)) for value in values if str(value).strip()}))
+        if normal_values:
+            evidence.append((normal_name, normal_values))
+
+    text = _candidate_text(candidate)
+    for group_name, markers in _TEXT_SEMANTIC_MARKERS:
+        matched = tuple(marker for marker in markers if marker in text)
+        if matched:
+            evidence.append((f"text:{group_name}", matched))
+
+    return tuple(sorted(set(evidence)))
+
+
+def _normalize_text(value: str) -> str:
+    return " ".join(re.split(r"\s+", value.casefold().replace("ё", "е").strip()))

    96	        if len(selected) == limit:
    97	            return selected
    98	
    99	    for candidate in ranked:
   100	        if candidate.ld_id in selected_ids:
   101	            continue
   102	        selected.append(candidate)
   103	        selected_ids.add(candidate.ld_id)
   104	        if len(selected) == limit:
   105	            break

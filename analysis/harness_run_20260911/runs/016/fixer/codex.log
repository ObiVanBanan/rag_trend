+_TEXT_SEMANTIC_MARKERS = (
+    ("material", ("латун", "сталь", "нержав", "чугун", "бронз", "полиэтилен", "пнд")),
+    ("medium", ("газ", "вода", "пар", "нефть", "масло", "кислород", "воздух")),

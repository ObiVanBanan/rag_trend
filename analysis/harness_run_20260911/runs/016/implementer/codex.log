+def test_hybrid_search_fails_open_when_structural_signature_extraction_fails(monkeypatch):
+    settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=2, rrf_k=60)
+    payloads = [
+        (
+            0.9,
+            {
+                "ld_id": 1,
+                "name": "Кран шаровой",
+                "article": "A1",
+                "dn": 50,
+                "pn": 16,
+                "joining_type": "фланцевое",
+                "search_text": "DN: 50 PN: 16 фланцевый",
+            },
+        ),
+        (
+            0.8,
+            {
+                "ld_id": 2,
+                "name": "Кран шаровой",
+                "article": "A2",
+                "dn": 50,
+                "pn": 16,
+                "joining_type": "фланцевое",
+                "search_text": "DN: 50 PN: 16 фланцевый",
+            },
+        ),
+    ]
+    retriever = HybridRetriever(Embedder(), DiversificationQdrantStore(payloads), EmptyBM25Store(), settings)
+
+    def raise_for_first(candidate):
+        if candidate.ld_id == 1:
+            raise ValueError("bad payload")
+        return None
+
+    monkeypatch.setattr("nomenclature_matcher.candidate_diversification.structural_signature", raise_for_first)

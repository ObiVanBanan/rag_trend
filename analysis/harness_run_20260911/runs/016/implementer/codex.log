+            {
+                "ld_id": 2,
+                "name": "Кран шаровой полнопроходной",
+                "article": "A2",
+                "dn": 50,
+                "pn": 16,
+                "joining_type": "фланцевое",
+                "search_text": "DN: 50 PN: 16 фланцевый полнопроходной",

+def test_hybrid_gate_fails_open_for_extractor_failure_uncertain_ambiguous_and_empty_constraints():
+    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20, hybrid_rerank_limit=20)
+    fallback_cases = [
+        ConstraintExtractor(error=RuntimeError("boom")),
+        ConstraintExtractor(constraints(catalog_scope="uncertain")),
+        ConstraintExtractor(constraints(ambiguous=True)),
+        ConstraintExtractor(constraints(product_type="other")),
+    ]
+    for extractor in fallback_cases:
+        candidates = [candidate(1, "Кран шаровый муфтовый DN50", joining_type="Муфтовое")]

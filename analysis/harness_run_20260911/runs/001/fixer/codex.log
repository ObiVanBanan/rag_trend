from dataclasses import replace

from .models import ConstraintGateDiagnostics, MatchResult, SearchCandidate, SelectedMatch
from .query_constraints import (
    DeepSeekQueryConstraintExtractor,
    candidate_constraint_check,
    constraint_summary,
    constraints_are_gate_eligible,
    evaluate_candidate_compatibility,
)


class NomenclatureMatcher:
    def __init__(
        self,
        embedder,
        store,
        settings,
        reranker=None,
        hybrid_retriever=None,
        constraint_extractor=None,
    ):
        self.embedder, self.store, self.settings = embedder, store, settings
        self.reranker = reranker
        self.hybrid_retriever = hybrid_retriever
        self.constraint_extractor = constraint_extractor
        if self.constraint_extractor is None and getattr(settings, "deepseek_api_key", ""):
            self.constraint_extractor = DeepSeekQueryConstraintExtractor(settings)

    def _normalize_query(self, query: str) -> str:
        return " ".join(query.split())

    def _search_candidates(self, query: str, limit: int) -> list[SearchCandidate]:
        hits = self.store.search(self.embedder.embed_query(query), limit)
        return [
            SearchCandidate(
                ld_id=int(hit.payload["ld_id"]),
                name=hit.payload.get("name", ""),
                article=hit.payload.get("article"),
                score=float(hit.score),
                price=hit.payload.get("price"),
                dn=hit.payload.get("dn"),
                pn=hit.payload.get("pn"),
                joining_type=hit.payload.get("joining_type"),
                url=hit.payload.get("url"),
                properties=hit.payload.get("properties"),
                search_text=hit.payload.get("search_text"),
                dense_score=float(hit.score),
                dense_rank=index,
                retrieval_sources=["dense"],
            )
            for index, hit in enumerate(hits, 1)
        ]

    def _build_selected_match(self, candidate: SearchCandidate, item) -> SelectedMatch:
        return SelectedMatch(
            candidate_id=item.candidate_id,
            article=candidate.article,
            name=candidate.name,
            llm_confidence=item.confidence,
            reason=item.reason,
            ld_id=candidate.ld_id,
            dense_score=candidate.dense_score,
            bm25_score=candidate.bm25_score,
            rrf_score=candidate.rrf_score,
            dn=candidate.dn,
            pn=candidate.pn,
            joining_type=candidate.joining_type,
            url=candidate.url,
        )

    def rerank_candidates(
        self,
        query: str,
        candidates: list[SearchCandidate],
        constraint_gate: ConstraintGateDiagnostics | None = None,
    ) -> MatchResult:
        if not candidates:
            return MatchResult(query=query, status="NOT_FOUND", candidates=[], constraint_gate=constraint_gate)
        if self.reranker is None:
            raise ValueError("Reranker is not configured")
        try:
            rerank_result = self.reranker.rerank(query, candidates)
        except Exception as exc:
            return MatchResult(
                query=query,
                status="RERANK_FAILED",
                score=candidates[0].score,
                ld_product=None,
                candidates=candidates,
                reason=str(exc),
                constraint_gate=constraint_gate,
            )
        selected = []
        for item in rerank_result.selected:
            candidate = candidates[item.candidate_id - 1]
            selected.append(self._build_selected_match(candidate, item))
        best = candidates[rerank_result.selected[0].candidate_id - 1] if rerank_result.selected else None
        return MatchResult(
            query=query,
            status=rerank_result.status,
            score=best.score if best else None,
            ld_product=best if rerank_result.status == "MATCHED" else None,
            candidates=candidates,
            selected=selected,
            reason=rerank_result.reason,
            constraint_gate=constraint_gate,
        )

    def match_one(self, query: str) -> MatchResult:
        query = self._normalize_query(query)
        if not query:
            return MatchResult(query=query, status="NOT_FOUND")
        candidates = self._search_candidates(query, self.settings.match_top_k)
        best = candidates[0] if candidates else None
        status = "MATCHED" if best and best.score >= self.settings.match_score_threshold else "NOT_FOUND"
        return MatchResult(query=query, status=status, score=best.score if best else None, ld_product=best if status == "MATCHED" else None, candidates=candidates)

    def match_one_with_rerank(self, query: str) -> MatchResult:
        query = self._normalize_query(query)
        if not query:
            return MatchResult(query=query, status="NOT_FOUND")
        candidates = self._search_candidates(query, self.settings.rerank_candidate_limit)
        return self.rerank_candidates(query, candidates)

    def _extract_constraint_gate(self, query: str) -> tuple[object | None, ConstraintGateDiagnostics | None]:
        if self.constraint_extractor is None:
            return None, None
        try:
            constraints = self.constraint_extractor.extract(query)
        except Exception as exc:
            return None, ConstraintGateDiagnostics(applied=False, fallback_reason=f"extractor_failed: {exc}")
        diagnostics = ConstraintGateDiagnostics(
            applied=False,
            constraints=constraint_summary(constraints),
        )
        if constraints.ambiguous:
            diagnostics.fallback_reason = "ambiguous_constraints"
            return None, diagnostics
        if constraints.catalog_scope == "out_of_scope":
            diagnostics.abstention_reason = "out_of_scope"
            return constraints, diagnostics
        if constraints.catalog_scope != "in_scope":
            diagnostics.fallback_reason = f"catalog_scope_{constraints.catalog_scope}"
            return None, diagnostics
        if not constraints_are_gate_eligible(constraints):
            diagnostics.fallback_reason = "no_usable_constraints"
            return None, diagnostics
        diagnostics.applied = True
        return constraints, diagnostics

    def _apply_constraint_gate(
        self,
        candidates: list[SearchCandidate],
        constraints,
        diagnostics: ConstraintGateDiagnostics,
    ) -> list[SearchCandidate]:
        retained: list[SearchCandidate] = []
        for index, candidate in enumerate(candidates, 1):
            compatibility = evaluate_candidate_compatibility(candidate, constraints)
            if compatibility.status == "contradictory":
                check = candidate_constraint_check(candidate, None, index, compatibility)
                diagnostics.excluded.append(check)
                continue
            retained.append(candidate)
            check = candidate_constraint_check(candidate, len(retained), index, compatibility)
            if compatibility.status == "unverifiable":
                diagnostics.retained_unverifiable.append(check)
            else:
                diagnostics.retained_compatible.append(check)
        if candidates and not retained:
            diagnostics.abstention_reason = "no_compatible_candidates"
        return retained

    def match_one_hybrid_with_rerank(self, query: str) -> MatchResult:
        query = self._normalize_query(query)
        if not query:
            return MatchResult(query=query, status="NOT_FOUND")
        if self.hybrid_retriever is None:
            raise ValueError("Hybrid retriever is not configured")
        constraints, diagnostics = self._extract_constraint_gate(query)
        if diagnostics and diagnostics.abstention_reason == "out_of_scope":
            return MatchResult(
                query=query,
                status="NOT_FOUND",
                reason=diagnostics.abstention_reason,
                constraint_gate=diagnostics,
            )
        candidates = self.hybrid_retriever.search(query, self.settings.hybrid_rerank_limit)
        if constraints is not None and diagnostics is not None and diagnostics.applied:
            gated_candidates = self._apply_constraint_gate(candidates, constraints, diagnostics)
            if not gated_candidates and candidates:
                return MatchResult(
                    query=query,
                    status="NOT_FOUND",
                    candidates=candidates,
                    reason=diagnostics.abstention_reason,
                    constraint_gate=diagnostics,
                )
            candidates = gated_candidates
        return self.rerank_candidates(query, candidates, constraint_gate=diagnostics)

    def _match_many_with(self, queries: list[str], match_one) -> list[MatchResult]:
        cache = {}
        for query in queries:
            normalized = self._normalize_query(query)
            if normalized and normalized not in cache:
                cache[normalized] = match_one(normalized)
        return [
            replace(cache[normalized], query=query)
            if (normalized := self._normalize_query(query)) and normalized in cache
            else MatchResult(query=query, status="NOT_FOUND")
            for query in queries
        ]

    def match_many(self, queries: list[str]) -> list[MatchResult]:
        return self._match_many_with(queries, self.match_one)

    def match_many_hybrid_with_rerank(self, queries: list[str]) -> list[MatchResult]:
        return self._match_many_with(queries, self.match_one_hybrid_with_rerank)

    match = match_many


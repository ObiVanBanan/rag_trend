+def product_from_search_candidate(candidate: SearchCandidate) -> LDProduct:
+    return LDProduct(
+        id=candidate.ld_id,
+        name=candidate.name,
+        article=candidate.article,
+        price=candidate.price,
+        dn=candidate.dn,
+        pn=candidate.pn,
+        joining_type=candidate.joining_type,
+        url=candidate.url,
+        properties=candidate.properties or [],
+    )
+
+
+def usable_constraint_fields(constraints: QueryConstraints) -> list[str]:
+    fields = []
+    if constraints.product_type != "other":
+        fields.append("product_type")
+    optional_fields = [
+        "dn",
+        "pn_min_mpa",
+        "joining_type",
+        "thread_type",
+        "working_medium",
+        "valve_type",
+        "valve_designation",
+        "body_material",
+        "body_material_grade",
+        "bore_type",
+        "control",
+    ]
+    fields.extend(field for field in optional_fields if getattr(constraints, field) is not None)
+    return fields
+
+
+def constraints_are_gate_eligible(constraints: QueryConstraints) -> bool:
+    return (
+        constraints.catalog_scope == "in_scope"
+        and not constraints.ambiguous
+        and bool(usable_constraint_fields(constraints))
+    )
+
+
+def constraint_summary(constraints: QueryConstraints) -> dict[str, Any]:
+    return {
+        key: value
+        for key, value in constraints.model_dump().items()
+        if key in {"catalog_scope", "ambiguous", "comment"} or key in usable_constraint_fields(constraints)
+    }
+
+
+@dataclass(frozen=True)
+class TriStateCompatibility:
+    status: str
+    checks: dict[str, str]
+    contradictory_fields: list[str]
+    unverifiable_fields: list[str]
+
+
+def evaluate_candidate_compatibility(candidate: SearchCandidate, constraints: QueryConstraints) -> TriStateCompatibility:
+    product = product_from_search_candidate(candidate)
+    checks: dict[str, str] = {}
+    contradictory: list[str] = []
+    unverifiable: list[str] = []
+
+    def exact(field: str, actual: Any, expected: Any) -> None:
+        checks[field] = f"{actual} == {expected}"
+        if actual is None:
+            unverifiable.append(field)
+        elif actual != expected:
+            contradictory.append(field)
+
+    if constraints.product_type != "other":
+        actual_product_type = candidate_product_type(product)
+        checks["product_type"] = f"{actual_product_type} == {constraints.product_type}"
+        if actual_product_type == "other":
+            unverifiable.append("product_type")
+        elif actual_product_type != constraints.product_type:
+            contradictory.append("product_type")
+    if constraints.dn is not None:
+        exact("dn", candidate_dn(product), constraints.dn)
+    if constraints.pn_min_mpa is not None:
+        actual_pn = candidate_pn_mpa(product)
+        checks["pn"] = f"{actual_pn} >= {constraints.pn_min_mpa} MPa"
+        if actual_pn is None:
+            unverifiable.append("pn")
+        elif actual_pn + 1e-9 < constraints.pn_min_mpa:
+            contradictory.append("pn")
+    if constraints.joining_type is not None:
+        exact("joining_type", candidate_joining_type(product), constraints.joining_type)
+    if constraints.thread_type is not None:
+        exact("thread_type", candidate_thread_type(product), constraints.thread_type)
+    if constraints.working_medium is not None:
+        expected_medium = _norm(constraints.working_medium)
+        actual_media = _medium_values(product)
+        checks["working_medium"] = f"{actual_media} contains exact {expected_medium}"
+        if not actual_media:
+            unverifiable.append("working_medium")
+        elif expected_medium not in actual_media:
+            contradictory.append("working_medium")
+    if constraints.valve_type is not None:
+        exact("valve_type", candidate_valve_type(product), constraints.valve_type)
+    if constraints.valve_designation is not None:
+        values = [product.article or "", product.name]
+        values.extend(_property_values(product, "Тип продукта", "Тип продукта AI", "Серия"))
+        checks["valve_designation"] = f"exact normalized {constraints.valve_designation}: {candidate_has_designation(product, constraints.valve_designation)}"
+        if not any(_norm(value) for value in values):
+            unverifiable.append("valve_designation")
+        elif not candidate_has_designation(product, constraints.valve_designation):
+            contradictory.append("valve_designation")
+    if constraints.body_material is not None:
+        exact("body_material", candidate_material(product), constraints.body_material)
+    if constraints.body_material_grade is not None:
+        expected_grade = _norm(constraints.body_material_grade)
+        actual_material_text = candidate_material_text(product)
+        grade_ok = _exact_token_match(actual_material_text, expected_grade)
+        checks["body_material_grade"] = f"exact {expected_grade}: {grade_ok}"
+        if not _norm(actual_material_text):
+            unverifiable.append("body_material_grade")
+        elif not grade_ok:
+            contradictory.append("body_material_grade")
+    if constraints.bore_type is not None:
+        exact("bore_type", candidate_bore_type(product), constraints.bore_type)
+    if constraints.control is not None:
+        exact("control", candidate_control(product), constraints.control)
+
+    if contradictory:
+        status = "contradictory"
+    elif unverifiable:
+        status = "unverifiable"
+    else:
+        status = "compatible"
+    return TriStateCompatibility(status, checks, contradictory, unverifiable)
+
+

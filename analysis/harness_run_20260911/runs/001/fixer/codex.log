def test_hybrid_gate_removes_contradictions_and_keeps_unverifiable_candidates():
    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20, hybrid_rerank_limit=20)
    candidates = [
        candidate(1, "Кран шаровый фланцевый DN50 PN16"),
        candidate(2, "Кран шаровый муфтовый DN50 PN16", joining_type="Муфтовое"),
        candidate(3, "", dn=None, pn=None, joining_type=None, properties=[]),
    ]
    reranker = Reranker(result=SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.9, reason="ok")], reason=None))
    extractor = ConstraintExtractor(constraints(dn=50, joining_type="flanged"))
    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=HybridRetriever(candidates), constraint_extractor=extractor)

    result = matcher.match_one_hybrid_with_rerank("Кран шаровой фланцевый Ду50")

    assert [item.ld_id for item in reranker.candidates] == [1, 3]
    assert result.constraint_gate.applied is True
    assert [item.ld_id for item in result.constraint_gate.excluded] == [2]
    assert [item.ld_id for item in result.constraint_gate.retained_unverifiable] == [3]
    assert result.constraint_gate.excluded[0].candidate_id is None
    assert result.constraint_gate.excluded[0].retrieval_rank == 2
    assert result.constraint_gate.retained_unverifiable[0].candidate_id == 2
    assert result.constraint_gate.retained_unverifiable[0].retrieval_rank == 3


def test_hybrid_gate_reranker_ids_are_renumbered_after_filtering_with_retrieval_rank_diagnostics():
    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20, hybrid_rerank_limit=20)
    candidates = [
        candidate(1, "Кран шаровый муфтовый DN50", joining_type="Муфтовое"),
        candidate(2, "Кран шаровый фланцевый DN50"),
    ]
    reranker = Reranker(result=SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.9, reason="ok")], reason=None))
    matcher = NomenclatureMatcher(
        Embedder(),
        Store([]),
        settings,
        reranker=reranker,
        hybrid_retriever=HybridRetriever(candidates),
        constraint_extractor=ConstraintExtractor(constraints(dn=50, joining_type="flanged")),
    )

    result = matcher.match_one_hybrid_with_rerank("Кран шаровой фланцевый Ду50")

    assert [item.ld_id for item in reranker.candidates] == [2]
    assert result.selected[0].ld_id == 2
    assert result.constraint_gate.excluded[0].candidate_id is None
    assert result.constraint_gate.excluded[0].retrieval_rank == 1
    assert result.constraint_gate.retained_compatible[0].candidate_id == 1
    assert result.constraint_gate.retained_compatible[0].retrieval_rank == 2


def test_hybrid_gate_abstains_out_of_scope_without_retrieval_or_rerank():
    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20, hybrid_rerank_limit=20)
    hybrid = HybridRetriever([candidate(1, "Кран шаровый")])
    reranker = Reranker(result=SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.9, reason="ok")], reason=None))
    extractor = ConstraintExtractor(constraints(product_type="other", catalog_scope="out_of_scope"))
    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid, constraint_extractor=extractor)

    result = matcher.match_one_hybrid_with_rerank("насос центробежный")

    assert result.status == "NOT_FOUND"
    assert result.reason == "out_of_scope"
    assert hybrid.calls == []
    assert not hasattr(reranker, "candidates")


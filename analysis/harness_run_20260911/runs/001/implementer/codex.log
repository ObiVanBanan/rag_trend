@@ -38,6 +38,21 @@
     assert result.canonical_query == "Кран латунный шаровой муфтовый DN 25 PN 16"
 
 
+def test_embedded_quantity_like_designation_fragment_is_preserved():
+    result = canonicalize_retrieval_query("Кран шаровой XШТ.123 DN50 PN16 стальной, количество 2 шт.")
+    assert result.source_query == "Кран шаровой XШТ.123 DN50 PN16 стальной, количество 2 шт."
+    assert result.canonical_query == "Кран шаровой XШТ.123 DN 50 PN 16 стальной"
+
+
+def test_standalone_quantity_tails_are_still_stripped_at_token_boundaries():
+    assert canonicalize_retrieval_query("Клапан 15с65нж DN50 PN16 4 шт.").canonical_query == (
+        "Клапан 15с65нж DN 50 PN 16"
+    )
+    assert canonicalize_retrieval_query("Клапан 15с65нж DN50 PN16, шт. 4").canonical_query == (
+        "Клапан 15с65нж DN 50 PN 16"
+    )
+
+
 def test_unsupported_or_ambiguous_text_does_not_gain_catalog_domain_terms():
     assert canonicalize_retrieval_query("Насос циркуляционный Ду25 2 шт").canonical_query is None
     assert canonicalize_retrieval_query("Поставка оборудования количество 2 шт").canonical_query is None


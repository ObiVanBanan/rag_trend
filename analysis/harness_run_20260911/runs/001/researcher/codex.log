for n,p in {'ball':r'шаров','butterfly':r'затвор','filter':r'фильтр','gate':r'задвиж','brass_ball':r'шаров.*латун|латун.*шаров','thread':r'резьб|муфтов','ivr':r'\\bivr\\b','valtec':r'\\bvaltec\\b','tecofi':r'\\btecofi\\b','bival':r'\\bбивал\\b'}.items():
 print(n,sum(bool(re.search(p,' '.join(str(v or '') for v in row.values()),re.I)) for row in rows))
# matching evidence labels profile
for s in ('MATCHED','NOT_FOUND'):
 ids={i for i,v in L.items() if v['expected_status']==s}; qs=[x['query'] for x in A if x['id'] in ids]
 print(s,len(qs),'ball',sum('шаров' in q.lower() for q in qs),'brand',sum(bool(brandpat.search(q)) for q in qs),'thread',sum(bool(re.search(r'вр|нр|\\d+[\"″]',q,re.I)) for q in qs))

 alts=[(x,canonicalize_retrieval_query(x['query']).canonical_query) for x in rs]
 print(name,'alternate',sum(y is not None for x,y in alts),'of',len(rs),'changed anchors',sum('кран' in x['query'].lower() and y is not None for x,y in alts))
 print('canonical sample');
 for x,y in [(x,y) for x,y in alts if y][:8]:print(x['id'],':',x['query'],'=>',y)
# relevant review brand value distribution
brandpat=re.compile(r'\\b(?:IVR|VALTEC|TECOFI|KVANT|БИВАЛ|GENEBRE|BUGATTI|BROEN|DANFOSS|AUMA)\\b',re.I)

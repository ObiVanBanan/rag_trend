+def _expand_standard_bore(text: str) -> str:
+    if not _BALL_VALVE_RE.search(text):
+        return text
+    if not _STANDARD_BORE_CONTEXT_RE.search(text):
+        return text
+    if _CONFLICTING_BORE_RE.search(text):
+        return text
+    additions = [term for term in _STANDARD_BORE_TERMS if not re.search(rf"\b{term}\b", text, re.IGNORECASE)]
+    if not additions:
+        return text
+    return f"{text} {' '.join(additions)}"

+def canonical_flange_subtype(text: Any) -> FlangeSubtype | None:
+    value = _norm(text)
+    if not value:
+        return None
+    if re.search(r"\bворотников\w*\b", value):
+        return "weld_neck"
+    if re.search(r"\bприварн\w*\s+встык\b|\bвстык\b", value):
+        return "weld_neck"
+    if re.search(r"\bтип\s*11\b|\btype\s*11\b", value):
+        return "weld_neck"
+    if re.search(r"\bплоск\w*\b", value):
+        return "flat"
+    if re.search(r"\bсвободн\w*\b", value):
+        return "loose"
+    if re.search(r"\bответн\w*\b|\bконтрфлан\w*\b", value):
+        return "counter"
+    return None
+
+
+def query_flange_subtype(query: str) -> FlangeSubtype | None:
+    if canonical_product_type(query) != "flange":
+        return None
+    return canonical_flange_subtype(query)
+
+
+def normalize_query_flange_subtype(query: str, constraints: QueryConstraints) -> QueryConstraints:
+    subtype = query_flange_subtype(query)
+    if subtype == constraints.flange_subtype:
+        return constraints
+    return constraints.model_copy(update={"flange_subtype": subtype})
+
+
+def candidate_flange_subtype(product: LDProduct) -> FlangeSubtype | None:
+    if candidate_product_type(product) != "flange":
+        return None
+    values = [product.name, product.article or ""]
+    for prop in product.properties or []:
+        values.append(str(prop.get("name") or ""))
+        values.extend(_flatten_values(prop.get("values")))
+    for value in values:
+        result = canonical_flange_subtype(value)
+        if result:
+            return result
+    return None
+
+
 def canonical_thread_type(text: Any) -> str | None:
     value = _norm(text)
     if not value:

+        [selected],
+    )
+
+    assert result.status == "MATCHED"
+    assert result.ld_product == selected
+    assert result.selected[0].ld_id == 1
+
+
+def test_generic_flange_and_non_flange_rerank_behavior_is_unchanged():
+    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20)
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.93, reason="best")], reason="ok")
+    generic = SearchCandidate(ld_id=1, name="Фланец DN80 PN16", article="F1", score=0.3)
+    valve = SearchCandidate(ld_id=2, name="Кран шаровой приварной встык DN80 PN16", article="K1", score=0.2)
+    reranker = Reranker(result=rerank_result)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker)
+
+    generic_result = matcher.rerank_candidates("Фланец DN80 PN16", [generic])
+    valve_result = matcher.rerank_candidates("Кран шаровой приварной встык DN80 PN16", [valve])
+
+    assert generic_result.status == "MATCHED"
+    assert generic_result.ld_product == generic
+    assert valve_result.status == "MATCHED"
+    assert valve_result.ld_product == valve
+    assert reranker.calls == [("Фланец DN80 PN16", [generic]), ("Кран шаровой приварной встык DN80 PN16", [valve])]

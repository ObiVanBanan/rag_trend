payload = {\"product_type\": \"ball_valve\", \"dn\": -1, \"pn_min_mpa\": -0.1}
try:
    result = QueryConstraints.model_validate(payload)
    print(\"accepted\", result.dn, result.pn_min_mpa)
except ValidationError as exc:
    print(\"rejected\", str(exc))
print(\"selection fields\", SelectionCompatibility.__annotations__)

+        ("control", requirements.control, verifiable_candidate_control(product)),
+        ("bore_type", requirements.bore_type, verifiable_candidate_bore_type(product)),
+    )
+    for field_name, expected, actual in checks:
+        if expected is None:
+            continue
+        detail = f"{actual} == {expected}"
+        if actual is None:
+            unknown[field_name] = detail
+        elif actual == expected:
+            satisfied[field_name] = detail
+        else:
+            contradicted[field_name] = detail
+    return SelectionCompatibility(satisfied=satisfied, contradicted=contradicted, unknown=unknown)
+
+
 def candidate_valve_type(product: LDProduct) -> str | None:
     if candidate_product_type(product) != "ball_valve":
         return None

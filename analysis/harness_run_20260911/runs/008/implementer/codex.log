+        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
+    )
+    unknown = product(
+        name="Кран шаровый LD фланцевый",
+        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
+    )
+
+    assert evaluate_selection_compatibility(satisfied, requirements).is_fully_compatible
+    result = evaluate_selection_compatibility(contradicted, requirements)

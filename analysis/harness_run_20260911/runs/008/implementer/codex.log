+def test_post_rerank_fallback_replaces_ordinary_query_underground_choice():
+    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20)
+    candidates = [
+        search_candidate(1, "Кран шаровый LD подземный полнопроходной ручное управление", score=0.03),

def test_unspecified_fields_do_not_filter_candidates():
    candidate = product(
        pn="4,0",
        properties=[
            {"name": "Тип продукта", "values": ["Кран шаровый"]},
            {"name": "Материал корпуса", "values": ["Сталь 09Г2С"]},
            {"name": "Тип прохода", "values": ["Редуцированный"]},
            {"name": "Рабочая среда", "values": ["Газ"]},
            {"name": "Управление", "values": ["Редуктор"]},
        ],
    )
    result = evaluate_product(
        candidate,
        constraints(
            working_medium=None,
            body_material=None,
            body_material_grade=None,
            bore_type=None,
            control=None,
        ),
    )
    assert result.matches is True


def test_selection_requirements_distinguish_electric_ready_from_installed_electric():
    ready = resolve_selection_requirements("Кран шаровой фланцевый под электропривод DN80")
    electric = resolve_selection_requirements("Кран шаровой фланцевый с электроприводом DN80")

    assert ready.control == "electric_ready"
    assert electric.control == "electric"


def test_selection_requirements_allowlist_positive_absent_and_ambiguous_wording():
    ordinary = resolve_selection_requirements("Кран шаровой фланцевый DN80 полнопроходной")
    unsupported = resolve_selection_requirements("Арматура запорная DN80")
    ambiguous_code = resolve_selection_requirements("КШЦФЭ DN80")

    assert ordinary.valve_type == "standard"
    assert ordinary.bore_type == "full"
    assert unsupported == resolve_selection_requirements("")
    assert ambiguous_code == resolve_selection_requirements("")


def test_verifiable_candidate_control_does_not_default_missing_control_to_manual():
    candidate = product(properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}])

    assert verifiable_candidate_control(candidate) is None


def test_selection_compatibility_reports_satisfied_contradicted_and_unknown():
    requirements = resolve_selection_requirements("Кран шаровой фланцевый с электроприводом полнопроходной")
    satisfied = product(
        name="Кран шаровый LD фланцевый с электроприводом полнопроходной",
        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
    )
    contradicted = product(
        name="Кран шаровый LD фланцевый под электропривод редуцированный",
        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
    )
    unknown = product(
        name="Кран шаровый LD фланцевый",
        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
    )

    assert evaluate_selection_compatibility(satisfied, requirements).is_fully_compatible
    result = evaluate_selection_compatibility(contradicted, requirements)
    assert set(result.contradicted) == {"control", "bore_type"}
    result = evaluate_selection_compatibility(unknown, requirements)
    assert set(result.unknown) == {"control", "bore_type"}


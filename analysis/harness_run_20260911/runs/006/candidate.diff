@@ -41,6 +41,10 @@ _UNSUPPORTED_ANCHOR_RE = re.compile(
     re.IGNORECASE,
 )
 _STANDALONE_WW_RE = re.compile(r"(?<![A-Za-zА-Яа-яЁё0-9])WW(?![A-Za-zА-Яа-яЁё0-9])", re.IGNORECASE)
+_SYMMETRIC_FLANGED_RE = re.compile(
+    r"(?<![A-Za-zА-Яа-яЁё0-9])фл\.?\s*/\s*фл\.?(?![A-Za-zА-Яа-яЁё0-9])",
+    re.IGNORECASE,
+)
 
 
 @dataclass(frozen=True)
@@ -61,6 +65,8 @@ def canonicalize_retrieval_query(query: str) -> RetrievalQueryCanonicalization:
     canonical = _extract_supported_clause(source)
     canonical = _strip_quantity_noise(canonical)
     canonical = _normalize_dn_pn(canonical)
+    if has_supported_anchor:
+        canonical = _expand_symmetric_connection_shorthand(canonical)
     canonical = _expand_joining_and_actuation(canonical)
     if has_supported_anchor:
         canonical = _expand_connection_notation(canonical)
@@ -121,7 +127,7 @@ def _normalize_dn_pn(text: str) -> str:
 
 def _expand_joining_and_actuation(text: str) -> str:
     replacements = (
-        (r"(?<!\w)фл\.?(?!\w)", "фланцевый"),
+        (r"(?<![\w/])фл\.?(?![\w/])", "фланцевый"),
         (r"\bм/ф\b", "муфтовый фланцевый"),
         (r"(?<!\w)муфт\.?(?!\w)", "муфтовый"),
         (r"(?<!\w)резьб\.?(?!\w)", "резьбовой"),
@@ -134,6 +140,10 @@ def _expand_joining_and_actuation(text: str) -> str:
     return text
 
 
+def _expand_symmetric_connection_shorthand(text: str) -> str:
+    return _SYMMETRIC_FLANGED_RE.sub("фланцевый", text)
+
+
 def _expand_connection_notation(text: str) -> str:
     return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
 

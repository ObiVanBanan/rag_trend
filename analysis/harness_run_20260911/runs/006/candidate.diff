@@ -13,6 +13,18 @@ def test_compact_dn_pn_and_joining_abbreviation_are_normalized():
     assert result.canonical_query == "Кран шаровой фланцевый DN 80 PN 16"
 
 
+def test_symmetric_flanged_shorthand_is_canonicalized_once():
+    result = canonicalize_retrieval_query("Кран шаровой фл/фл Ду80 Ру16 стальной")
+    assert result.source_query == "Кран шаровой фл/фл Ду80 Ру16 стальной"
+    assert result.canonical_query == "Кран шаровой фланцевый DN 80 PN 16 стальной"
+    assert result.canonical_query.count("фланцевый") == 1
+
+
+def test_symmetric_flanged_shorthand_accepts_case_dots_and_spaces():
+    result = canonicalize_retrieval_query("Задвижка ФЛ. / фл. DN100 PN16")
+    assert result.canonical_query == "Задвижка фланцевый DN 100 PN 16"
+
+
 def test_standalone_ww_connection_code_adds_welded_vocabulary():
     result = canonicalize_retrieval_query("Кран шаровой WW DN100 PN25")
     assert result.source_query == "Кран шаровой WW DN100 PN25"
@@ -49,6 +61,20 @@ def test_embedded_or_unknown_connection_codes_do_not_add_welded_vocabulary():
     assert canonicalize_retrieval_query("Кран шаровой FF DN100 PN25").canonical_query == "Кран шаровой FF DN 100 PN 25"
 
 
+def test_symmetric_flanged_shorthand_keeps_strict_boundaries_and_allowlist():
+    assert canonicalize_retrieval_query("Кран шаровой афл/фл DN100 PN16").canonical_query == "Кран шаровой афл/фл DN 100 PN 16"
+    assert canonicalize_retrieval_query("Кран шаровой фл/флан DN100 PN16").canonical_query == "Кран шаровой фл/флан DN 100 PN 16"
+    assert canonicalize_retrieval_query("Кран шаровой м/ф DN100 PN16").canonical_query == "Кран шаровой муфтовый фланцевый DN 100 PN 16"
+    assert canonicalize_retrieval_query("Кран шаровой FF/FF DN100 PN16").canonical_query == "Кран шаровой FF/FF DN 100 PN 16"
+
+
+def test_symmetric_flanged_shorthand_requires_supported_product_anchor():
+    result = canonicalize_retrieval_query("Поставка фл/фл DN100 PN16")
+    assert result.canonical_query == "Поставка фл/фл DN 100 PN 16"
+    assert "фланцевый" not in result.canonical_query
+    assert canonicalize_retrieval_query("Насос фл/фл DN100 PN16").canonical_query is None

    assert matcher.match_one(" x ").status == "MATCHED"
    assert matcher.match_one("low").status == "MATCHED"
    assert matcher.match_one("   ").status == "NOT_FOUND"
    assert len(embedder.calls) == 2


def test_not_found_cases_and_duplicate_queries():

diff --git a/src/nomenclature_matcher/query_canonicalization.py b/src/nomenclature_matcher/query_canonicalization.py
index 9c5ca8465fb64f6f01705e940702520bc1e6dcba..b5e0f947bc3aa13aa891907a9bfeeb5613adce71
--- a/src/nomenclature_matcher/query_canonicalization.py
+++ b/src/nomenclature_matcher/query_canonicalization.py
@@ -41,6 +41,10 @@
     re.IGNORECASE,
 )
 _STANDALONE_WW_RE = re.compile(r"(?<![A-Za-zА-Яа-яЁё0-9])WW(?![A-Za-zА-Яа-яЁё0-9])", re.IGNORECASE)
+_SYMMETRIC_FLANGED_RE = re.compile(
+    r"(?<![A-Za-zА-Яа-яЁё0-9])фл\.?\s*/\s*фл\.?(?![A-Za-zА-Яа-яЁё0-9])",
+    re.IGNORECASE,
+)
 
 
 @dataclass(frozen=True)
@@ -61,6 +65,8 @@
     canonical = _extract_supported_clause(source)
     canonical = _strip_quantity_noise(canonical)
     canonical = _normalize_dn_pn(canonical)
+    if has_supported_anchor:
+        canonical = _expand_symmetric_connection_shorthand(canonical)
     canonical = _expand_joining_and_actuation(canonical)
     if has_supported_anchor:
         canonical = _expand_connection_notation(canonical)
@@ -121,7 +127,7 @@
 
 def _expand_joining_and_actuation(text: str) -> str:
     replacements = (
-        (r"(?<!\w)фл\.?(?!\w)", "фланцевый"),
+        (r"(?<![\w/])фл\.?(?![\w/])", "фланцевый"),
         (r"\bм/ф\b", "муфтовый фланцевый"),
         (r"(?<!\w)муфт\.?(?!\w)", "муфтовый"),
         (r"(?<!\w)резьб\.?(?!\w)", "резьбовой"),
@@ -134,6 +140,10 @@
     return text
 
 
+def _expand_symmetric_connection_shorthand(text: str) -> str:
+    return _SYMMETRIC_FLANGED_RE.sub("фланцевый", text)
+
+
 def _expand_connection_notation(text: str) -> str:
     return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
 
diff --git a/tests/test_hybrid_retriever.py b/tests/test_hybrid_retriever.py
index a3cdc9ded23e019732e55e465a227e003fcf1602..ece1cd60f5bde915d98b772414f2cf6cb5c82565
--- a/tests/test_hybrid_retriever.py
+++ b/tests/test_hybrid_retriever.py
@@ -133,6 +133,21 @@
     assert len({candidate.ld_id for candidate in results}) == len(results)
 
 
+def test_hybrid_search_uses_symmetric_flanged_alternate_and_dedupes_by_ld_id():
+    settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=20, rrf_k=60)
+    embedder = EchoEmbedder()
+    bm25 = VariantBM25Store()
+    retriever = HybridRetriever(embedder, VariantQdrantStore(), bm25, settings)
+    original = "Кран шаровой фл/фл DN100 PN16"
+    canonical = "Кран шаровой фланцевый DN 100 PN 16"
+
+    results = retriever.search(original, canonical_query=canonical)
+
+    assert embedder.calls == [original, canonical]
+    assert bm25.calls == [(original, 50), (canonical, 50)]
+    assert len({candidate.ld_id for candidate in results}) == len(results)
+
+
 def test_hybrid_search_merges_variants_per_modality_before_rrf():
     settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=20, rrf_k=60)
     retriever = HybridRetriever(EchoEmbedder(), VariantQdrantStore(), VariantBM25Store(), settings)
diff --git a/tests/test_matcher.py b/tests/test_matcher.py
index 3756a80765e09a5ca5fb6258fce81ee6de297695..5d021b3ee45d926dfe968096c969842f8cf3f1e4
--- a/tests/test_matcher.py
+++ b/tests/test_matcher.py
@@ -186,3 +186,30 @@
         )
     ]
     assert reranker.calls[0][0] == "Кран шаровой WW DN100 PN25"
+
+
+def test_match_one_hybrid_symmetric_flanged_alternate_preserves_original_query_for_output_and_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран фланцевый", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.91, reason="flanged")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Кран шаровой фл/фл DN100 PN16  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+
+    assert result.query == "Кран шаровой фл/фл DN100 PN16"
+    assert hybrid.calls == [
+        (
+            "Кран шаровой фл/фл DN100 PN16",
+            20,
+            "Кран шаровой фланцевый DN 100 PN 16",
+        )
+    ]
+    assert reranker.calls[0][0] == "Кран шаровой фл/фл DN100 PN16"
diff --git a/tests/test_query_canonicalization.py b/tests/test_query_canonicalization.py
index fbcc570a2ce41c6320a6308bf30be1cd4ef51197..9667ee2b3459d7af8dbb39d7273cb999155454df

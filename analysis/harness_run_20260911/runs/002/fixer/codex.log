+def compatibility_summary(product: LDProduct, constraints: QueryConstraints) -> CompatibilitySummary:
+    satisfied: list[str] = []
+    contradictory: list[str] = []
+    unverified: list[str] = []
+
+    def exact(field: str, actual: Any, expected: Any) -> None:
+        if expected is None:
+            return
+        if actual is None or actual == "":
+            unverified.append(f"{field}: expected {expected}, catalog value unavailable")
+        elif actual == expected:
+            satisfied.append(f"{field}: {actual}")
+        else:
+            contradictory.append(f"{field}: expected {expected}, catalog has {actual}")
+
+    exact("product_type", candidate_product_type(product), constraints.product_type)
+    exact("dn", candidate_dn(product), constraints.dn)
+
+    if constraints.pn_min_mpa is not None:
+        actual_pn = candidate_pn_mpa(product)
+        if actual_pn is None:
+            unverified.append(f"pn_min_mpa: expected >= {constraints.pn_min_mpa}, catalog value unavailable")
+        elif actual_pn + 1e-9 >= constraints.pn_min_mpa:
+            satisfied.append(f"pn_min_mpa: {actual_pn} >= {constraints.pn_min_mpa}")
+        else:
+            contradictory.append(f"pn_min_mpa: expected >= {constraints.pn_min_mpa}, catalog has {actual_pn}")
+
+    exact("joining_type", candidate_joining_type(product), constraints.joining_type)
+    exact("thread_type", candidate_thread_type(product), constraints.thread_type)
+
+    if constraints.working_medium is not None:
+        expected_medium = _norm(constraints.working_medium)
+        actual_media = _medium_values(product)
+        if not actual_media:
+            unverified.append(f"working_medium: expected {expected_medium}, catalog value unavailable")
+        elif expected_medium in actual_media:
+            satisfied.append(f"working_medium: {expected_medium}")
+        else:
+            contradictory.append(f"working_medium: expected {expected_medium}, catalog has {', '.join(actual_media)}")
+
+    exact("valve_type", _documented_candidate_valve_type(product), constraints.valve_type)
+
+    if constraints.valve_designation is not None:
+        if candidate_has_designation(product, constraints.valve_designation):
+            satisfied.append(f"valve_designation: {constraints.valve_designation}")
+        elif _candidate_has_any_documented_designation(product):
+            contradictory.append(f"valve_designation: expected exact {constraints.valve_designation}, catalog differs")
+        else:
+            unverified.append(
+                f"valve_designation: expected exact {constraints.valve_designation}, catalog value unavailable"
+            )
+
+    exact("body_material", candidate_material(product), constraints.body_material)
+
+    if constraints.body_material_grade is not None:
+        expected_grade = _norm(constraints.body_material_grade)
+        actual_material_text = candidate_material_text(product)
+        if not _norm(actual_material_text):
+            unverified.append(f"body_material_grade: expected {expected_grade}, catalog value unavailable")
+        elif _exact_token_match(actual_material_text, expected_grade):
+            satisfied.append(f"body_material_grade: {expected_grade}")
+        else:
+            contradictory.append(f"body_material_grade: expected {expected_grade}, catalog differs")
+
+    exact("bore_type", candidate_bore_type(product), constraints.bore_type)
+    exact("control", _documented_candidate_control(product), constraints.control)
+    return CompatibilitySummary(satisfied=satisfied, contradictory=contradictory, unverified=unverified)
+

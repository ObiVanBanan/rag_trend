+            article="A1",
+            score=0.02,
+            dn="200",
+            pn="1,6",
+            joining_type="Фланцевое",
+            search_text="ordinary",
+        ),
+        SearchCandidate(
+            ld_id=2,
+            name="Кран шаровый LD для подземной установки КШЦП из стали 20 Ду200 Ру1,6МПа",
+            article="A2",
+            score=0.03,
+            dn="200",
+            pn="1,6",
+            joining_type="Фланцевое",
+            search_text="underground",
+        ),
+    ]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.9, reason="best")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    extractor = Extractor(
+        result=QueryConstraints(
+            product_type="ball_valve",
+            dn=200,
+            pn_min_mpa=1.6,
+            joining_type="flanged",
+            valve_type="standard",
+            catalog_scope="in_scope",

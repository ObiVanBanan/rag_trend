+def _property_text(properties: list[dict[str, Any]], allowed_names: set[str]) -> str:
+    parts: list[str] = []
+    for prop in properties:
+        name = prop.get("name")
+        if name in allowed_names:
+            values = prop.get("values", [])
+            if values not in (None, "", []):
+                parts.append(f"{name}: {_format_values(values)}")
+    return " ".join(parts)
+
+
+def _normalize_descriptor_source(text: str) -> str:
+    return f" {text.lower().replace('ё', 'е')} "
+
+
+def build_execution_descriptors(product: LDProduct) -> list[str]:
+    properties = _properties(product.properties)
+    product_type_source = _normalize_descriptor_source(
+        f"{product.name} {_property_text(properties, {'Тип продукта'})}"
+    )
+    if "кран" not in product_type_source or "шаров" not in product_type_source:
+        return []
+
+    evidence = _normalize_descriptor_source(
+        f"{product.name} {_property_text(properties, _DESCRIPTOR_PROPERTY_NAMES)}"
+    )
+    descriptors = [
+        descriptor
+        for descriptor, markers in _SPECIAL_EXECUTION_DESCRIPTORS
+        if any(marker in evidence for marker in markers)
+    ]
+    if not descriptors:
+        descriptors.append("стандартное исполнение")
+
+    passage = _normalize_descriptor_source(_property_text(properties, {"Тип прохода"}))
+    if any(marker in passage for marker in ("неполнопроход", "не полный", "редуц", "стандарт")):
+        descriptors.append("стандартный проход")
+    elif any(marker in passage for marker in ("полнопроход", "полный проход", "полный")):
+        descriptors.append("полнопроходной")
+
+    return descriptors
+
+

diff --git a/tests/test_bm25.py b/tests/test_bm25.py
index 3ad73c79cea5c43a5c67137a7b68d34e07101e14..c360a191a83e8e1d2e4f2cc482c85861e2bfd3a5
--- a/tests/test_bm25.py
+++ b/tests/test_bm25.py
@@ -70,3 +70,46 @@
 
     assert hits[0].ld_id == 2
     assert "Исполнение: подземное исполнение" in hits[0].search_text
+
+
+def test_bm25_execution_descriptors_separate_ordinary_and_specialised_ball_valves():
+    products = [
+        LDProduct(
+            1,
+            "Кран шаровой стальной DN80 PN16 фланцевый",
+            "A1",
+            dn="80",
+            pn="16",
+            joining_type="Фланцевое",
+            properties={"properties": [{"name": "Тип продукта", "values": ["Кран шаровой"]}]},
+        ),
+        LDProduct(
+            2,
+            "Кран шаровой стальной DN80 PN16 фланцевый для подземной установки",
+            "A2",
+            dn="80",
+            pn="16",
+            joining_type="Фланцевое",
+            properties={"properties": [{"name": "Тип продукта", "values": ["Кран шаровой"]}]},
+        ),
+        LDProduct(
+            3,
+            "Кран шаровой стальной DN80 PN16 фланцевый Regula",
+            "A3",
+            dn="80",
+            pn="16",
+            joining_type="Фланцевое",
+            properties={"properties": [{"name": "Тип продукта", "values": ["Кран шаровой"]}]},
+        ),
+    ]
+
+    store = BM25Store(products)
+
+    ordinary_hits = store.search("обычный кран шаровой стандартное исполнение DN80 PN16 фланцевый", limit=3)
+    underground_hits = store.search("кран шаровой для подземной установки DN80 PN16 фланцевый", limit=3)
+    regulating_hits = store.search("кран шаровой регулирующий DN80 PN16 фланцевый", limit=3)
+
+    assert ordinary_hits[0].ld_id == 1
+    assert underground_hits[0].ld_id == 2
+    assert regulating_hits[0].ld_id == 3
+    assert {hit.ld_id for hit in ordinary_hits} == {1, 2, 3}

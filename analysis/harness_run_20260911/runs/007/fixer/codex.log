+def _property_text(properties: list[dict[str, Any]], allowed_names: set[str]) -> str:
+    parts: list[str] = []
+    for prop in properties:
+        name = prop.get("name")
+        if name in allowed_names:
+            values = prop.get("values", [])
+            if values not in (None, "", []):
+                parts.append(f"{name}: {_format_values(values)}")
+    return " ".join(parts)
+
+
+def _normalize_descriptor_source(text: str) -> str:
+    return f" {text.lower().replace('ё', 'е')} "
+
+
+def _is_ball_valve(text: str) -> bool:
+    return bool(_BALL_VALVE_RE.search(text))
+
+
+def _has_regulating_evidence(text: str) -> bool:
+    if _REGULA_RE.search(text):
+        return True
+    if _NEGATED_REGULATING_RE.search(text):
+        return False
+    return bool(_REGULATING_RE.search(text))
+
+
+def build_execution_descriptors(product: LDProduct) -> list[str]:
+    properties = _properties(product.properties)
+    product_type_sources = [
+        _normalize_descriptor_source(product.name),
+        _normalize_descriptor_source(_property_text(properties, {"Тип продукта"})),
+    ]
+    if not any(_is_ball_valve(source) for source in product_type_sources):
+        return []
+
+    evidence = _normalize_descriptor_source(
+        f"{product.name} {_property_text(properties, _DESCRIPTOR_PROPERTY_NAMES)}"
+    )
+    descriptors = []
+    if _UNDERGROUND_RE.search(evidence):
+        descriptors.append("подземное исполнение")
+    if _has_regulating_evidence(evidence):
+        descriptors.append("регулирующее исполнение")
+    if _CRYOGENIC_RE.search(evidence):
+        descriptors.append("криогенное исполнение")
+    if _GAS_RE.search(evidence):
+        descriptors.append("газовое исполнение")
+    if _ELECTRIC_READY_RE.search(evidence):
+        descriptors.append("под электропривод")
+    if not descriptors:
+        descriptors.append("стандартное исполнение")
+
+    passage = _normalize_descriptor_source(_property_text(properties, {"Тип прохода"}))
+    if any(marker in passage for marker in ("неполнопроход", "не полный", "редуц", "стандарт")):
+        descriptors.append("стандартный проход")
+    elif any(marker in passage for marker in ("полнопроход", "полный проход", "полный")):
+        descriptors.append("полнопроходной")
+
+    return descriptors
+
+

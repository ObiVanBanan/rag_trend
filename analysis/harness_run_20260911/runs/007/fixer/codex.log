+
+    ordinary_hits = store.search("обычный кран шаровой стандартное исполнение DN80 PN16 фланцевый", limit=3)
+    underground_hits = store.search("кран шаровой для подземной установки DN80 PN16 фланцевый", limit=3)
+    regulating_hits = store.search("кран шаровой регулирующее исполнение DN80 PN16 фланцевый", limit=3)
+
+    assert ordinary_hits[0].ld_id == 1
+    assert underground_hits[0].ld_id == 2
+    assert regulating_hits[0].ld_id == 3
+    assert any("для подземной установки" in text for text in store.search_texts)
+    assert any("Regula" in text for text in store.search_texts)

+)
+def test_build_execution_descriptors_are_bounded_and_ordered(product, expected):
+    assert build_execution_descriptors(product) == expected
+
+
+def test_build_execution_descriptors_skip_non_ball_valves():
+    product = LDProduct(
+        1,
+        "Затвор дисковый подземный под электропривод",
+        properties={"properties": [{"name": "Тип продукта", "values": ["Затвор дисковый"]}]},
+    )
+
+    assert build_execution_descriptors(product) == []
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "Кран шаровой нерегулируемый DN80 PN16",
+        "Кран шаровой не регулирующий DN80 PN16",
+        "Кран шаровой не является регулирующим DN80 PN16",
+    ],
+)
+def test_build_execution_descriptors_do_not_promote_negated_regulating_evidence(name):
+    product = LDProduct(
+        1,
+        name,
+        properties={"properties": [{"name": "Тип продукта", "values": ["Кран шаровой"]}]},
+    )
+
+    assert build_execution_descriptors(product) == ["стандартное исполнение"]
+
+
+@pytest.mark.parametrize(
+    "product",
+    [
+        LDProduct(
+            1,
+            "Экран шаровой опоры подземный",
+            properties={"properties": [{"name": "Тип продукта", "values": ["Опора"]}]},
+        ),
+        LDProduct(
+            2,
+            "Кран мостовой для шаровой мельницы",
+            properties={"properties": [{"name": "Тип продукта", "values": ["Кран мостовой"]}]},
+        ),
+    ],
+)
+def test_build_execution_descriptors_skip_near_miss_non_ball_valve_text(product):
+    assert build_execution_descriptors(product) == []
+
+
+def test_build_execution_descriptors_keep_conflicting_special_evidence_without_standard_execution():
+    product = LDProduct(
+        1,
+        "Кран шаровой LD Regula для подземной установки",
+        properties={
+            "properties": [
+                {"name": "Тип продукта", "values": ["Кран шаровой"]},
+                {"name": "Тип прохода", "values": ["Полнопроходной"]},
+                {"name": "Управление", "values": ["под электропривод"]},
+            ]
+        },
+    )
+
+    assert build_execution_descriptors(product) == [
+        "подземное исполнение",
+        "регулирующее исполнение",
+        "под электропривод",
+        "полнопроходной",
+    ]
+
+
+def test_execution_descriptors_are_additive_and_preserve_raw_catalog_text():
+    product = LDProduct(
+        1,
+        "Кран шаровой LD Regula Ду 50",
+        "A-REG",
+        dn="50",
+        properties={
+            "properties": [
+                {"name": "Тип продукта", "values": ["Кран шаровой"]},
+                {"name": "Тип прохода", "values": ["Редуцированный"]},
+            ]
+        },
+    )
+
+    search_text = build_search_text(product)
+    lexical_text = build_lexical_text(product)
+
+    for text in (search_text, lexical_text):
+        assert "Кран шаровой LD Regula Ду 50" in text
+        assert "Тип прохода: Редуцированный" in text
+        assert "Исполнение: регулирующее исполнение, стандартный проход" in text
+        assert "стандартное исполнение" not in text


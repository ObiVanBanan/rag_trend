+def test_mixed_work_product_line_adds_product_span_alternate_with_constraints():
+    result = canonicalize_retrieval_query(
+        "Замена изношенного участка: кран шаровой латунный муфт. Ду25 Ру16 с ручным управлением, количество 2 шт."
+    )
+    assert result.source_query.startswith("Замена изношенного участка")
+    assert result.canonical_query == "кран шаровой латунный муфтовый DN 25 PN 16 с ручным управлением"
+
+
+def test_mixed_work_product_extraction_is_conservative():
+    service_only = canonicalize_retrieval_query("Замена изношенного участка трубопровода Ду25 Ру16")
+    assert service_only.canonical_query == "Замена изношенного участка трубопровода DN 25 PN 16"
+
+    product_line = canonicalize_retrieval_query("Кран шаровой латунный муфт. Ду25 Ру16")
+    assert product_line.canonical_query == "Кран шаровой латунный муфтовый DN 25 PN 16"
+
+    separated = canonicalize_retrieval_query("Замена участка трубопровода. Кран шаровой латунный муфт. Ду25 Ру16")
+    assert separated.canonical_query == "Кран шаровой латунный муфтовый DN 25 PN 16"
+
+
 def test_unsupported_or_ambiguous_text_does_not_gain_catalog_domain_terms():

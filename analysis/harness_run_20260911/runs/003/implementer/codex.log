+def test_match_one_hybrid_mixed_work_product_span_is_retrieval_only():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран латунный", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.91, reason="span")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Замена узла: кран шаровой латунный муфт. Ду25 Ру16 с ручным управлением  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+
+    normalized = "Замена узла: кран шаровой латунный муфт. Ду25 Ру16 с ручным управлением"
+    assert result.query == normalized
+    assert hybrid.calls == [
+        (
+            normalized,
+            20,
+            "кран шаровой латунный муфтовый DN 25 PN 16 с ручным управлением",
+        )
+    ]
+    assert reranker.calls[0][0] == normalized
+
+
+def test_match_one_hybrid_service_only_work_cue_does_not_force_not_found():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Fallback", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.8, reason="candidate")], reason=None)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=Reranker(result=rerank_result), hybrid_retriever=hybrid)
+
+    result = matcher.match_one_hybrid_with_rerank("Замена изношенного участка трубопровода Ду25 Ру16")
+
+    assert result.status == "MATCHED"
+    assert hybrid.calls == [("Замена изношенного участка трубопровода Ду25 Ру16", 20, "Замена изношенного участка трубопровода DN 25 PN 16")]

+def _extract_mixed_work_product_span(text: str) -> str | None:
+    action = _WORK_ACTION_RE.search(text)
+    if not action:
+        return None
+    anchor = _SUPPORTED_ANCHOR_RE.search(text, action.end())
+    if not anchor:
+        return None
+    clause_start = _clause_start(text, anchor.start())
+    if action.start() < clause_start:
+        return None
+    earlier_anchor = _SUPPORTED_ANCHOR_RE.search(text, action.end(), anchor.start())
+    if earlier_anchor:
+        return None
+    clause_end = _clause_end(text, anchor.end())
+    if clause_end <= anchor.start():
+        return None
+    return text[anchor.start():clause_end].strip(" ,;:.")
+
+
 def _clause_start(text: str, anchor_start: int) -> int:
     left = text[:anchor_start]
     matches = list(re.finditer(r"(?:^|[.;])\s*(?:поз\.?\s*)?\d+\s*[-.):]\s*", left, re.IGNORECASE))

+        rf"(?<![{_ALNUM_RU}])исп\w*\s*11(?![{_ALNUM_RU}])",
+    ),
+    "flat": (
+        rf"(?<![{_ALNUM_RU}])плоск\w*",
+        rf"(?<![{_ALNUM_RU}])тип\s*01(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])type\s*01(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])исп\w*\s*01(?![{_ALNUM_RU}])",

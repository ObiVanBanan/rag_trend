+        rf"(?<![{_ALNUM_RU}])weld\s*neck(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])butt\s*weld(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])тип\s*11(?![{_ALNUM_RU}])",

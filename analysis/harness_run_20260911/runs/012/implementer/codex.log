+        rf"(?<![{_ALNUM_RU}])loose(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])тип\s*02(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])type\s*02(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])исп\w*\s*02(?![{_ALNUM_RU}])",

+def _has_any_pattern(text: Any, patterns: tuple[str, ...]) -> bool:
+    value = _norm(text)
+    return any(re.search(pattern, value) for pattern in patterns)
+
+
+_FLANGE_SUBTYPE_PATTERNS: dict[str, tuple[str, ...]] = {
+    "weld_neck": (
+        rf"(?<![{_ALNUM_RU}])воротников\w*",
+        rf"(?<![{_ALNUM_RU}])приварн\w*\s+в\s*стык(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])weld\s*neck(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])butt\s*weld(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])тип\s*11(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])type\s*11(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])исп\w*\s*11(?![{_ALNUM_RU}])",
+    ),
+    "flat": (
+        rf"(?<![{_ALNUM_RU}])плоск\w*",
+        rf"(?<![{_ALNUM_RU}])тип\s*01(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])type\s*01(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])исп\w*\s*01(?![{_ALNUM_RU}])",
+    ),
+    "loose": (
+        rf"(?<![{_ALNUM_RU}])свободн\w*",
+        rf"(?<![{_ALNUM_RU}])loose(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])тип\s*02(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])type\s*02(?![{_ALNUM_RU}])",
+        rf"(?<![{_ALNUM_RU}])исп\w*\s*02(?![{_ALNUM_RU}])",
+    ),
+    "counter": (
+        rf"(?<![{_ALNUM_RU}])ответн\w*",
+        rf"(?<![{_ALNUM_RU}])контрфлан\w*",
+        rf"(?<![{_ALNUM_RU}])counter\s*flange(?![{_ALNUM_RU}])",
+    ),
+}
+
+
+def query_flange_subtype(text: Any) -> str | None:
+    matches = [
+        subtype
+        for subtype, patterns in _FLANGE_SUBTYPE_PATTERNS.items()
+        if _has_any_pattern(text, patterns)
+    ]
+    return matches[0] if len(matches) == 1 else None
+
+
+def candidate_flange_subtype(product: LDProduct) -> str:
+    if candidate_product_type(product) != "flange":
+        return "unknown"
+    text = _product_text(product)
+    matches = [
+        subtype
+        for subtype, patterns in _FLANGE_SUBTYPE_PATTERNS.items()
+        if _has_any_pattern(text, patterns)
+    ]
+    return matches[0] if len(matches) == 1 else "unknown"
+

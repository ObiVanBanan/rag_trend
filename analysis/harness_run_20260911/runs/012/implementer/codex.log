+def flange(name, *, properties=None):
+    return LDProduct(
+        id=10,
+        name=name,
+        article="F-10",
+        joining_type="Фланцевое",
+        properties=properties or [{"name": "Тип продукта", "values": ["Фланец"]}],
+    )
+
+
+def test_query_flange_subtype_recognizes_allowlisted_cues():
+    assert query_flange_subtype("Фланец воротниковый DN80 PN16") == "weld_neck"
+    assert query_flange_subtype("Фланец приварной в стык DN80") == "weld_neck"
+    assert query_flange_subtype("Фланец weld neck type 11") == "weld_neck"
+    assert query_flange_subtype("Фланец плоский стальной") == "flat"
+    assert query_flange_subtype("Фланец свободный на приварном кольце") == "loose"
+    assert query_flange_subtype("Ответный фланец DN80") == "counter"
+
+
+def test_query_flange_subtype_leaves_generic_or_ambiguous_unspecified():
+    assert query_flange_subtype("Фланец стальной DN80 PN16") is None
+    assert query_flange_subtype("Фланец плоский воротниковый DN80") is None
+
+
+def test_candidate_flange_subtype_requires_affirmative_catalog_evidence():
+    assert candidate_flange_subtype(flange("Фланец воротниковый стальной тип 11 DN80")) == "weld_neck"
+    assert candidate_flange_subtype(flange("Фланец плоский стальной тип 01 DN80")) == "flat"
+    assert candidate_flange_subtype(flange("Фланец свободный тип 02 DN80")) == "loose"
+    assert candidate_flange_subtype(flange("Контрфланец стальной DN80")) == "counter"
+    assert candidate_flange_subtype(flange("Фланец стальной DN80 PN16")) == "unknown"
+    assert candidate_flange_subtype(flange("Фланец плоский воротниковый DN80")) == "unknown"
+
+
+def test_flange_subtype_constraint_rejects_flat_or_unknown_for_weld_neck():
+    weld_neck = constraints(product_type="flange", flange_subtype="weld_neck", dn=None, pn_min_mpa=None, joining_type=None, valve_type=None)
+    assert evaluate_product(flange("Фланец воротниковый тип 11 DN80"), weld_neck).matches is True
+    assert evaluate_product(flange("Фланец плоский тип 01 DN80"), weld_neck).matches is False
+    assert evaluate_product(flange("Фланец стальной DN80"), weld_neck).matches is False
+
+
+def test_generic_flange_constraint_and_snapshot_do_not_apply_subtype():
+    generic = constraints(product_type="flange", flange_subtype=None, dn=None, pn_min_mpa=None, joining_type=None, valve_type=None)
+    candidate = flange("Фланец стальной DN80")
+    assert evaluate_product(candidate, generic).matches is True
+    snapshot = product_snapshot(candidate, generic)
+    assert "flange_subtype" not in snapshot
+    assert "flange_subtype" not in snapshot["checks"]


+    assert query_flange_subtype("Фланец воротниковый DN80 PN16") == "weld_neck"
+    assert query_flange_subtype("Фланец приварной в стык DN80") == "weld_neck"
+    assert query_flange_subtype("Фланец weld neck type 11") == "weld_neck"
+    assert query_flange_subtype("Фланец плоский стальной") == "flat"
+    assert query_flange_subtype("Фланец свободный на приварном кольце") == "loose"
+    assert query_flange_subtype("Ответный фланец DN80") == "counter"
+
+
+def test_query_flange_subtype_leaves_generic_or_ambiguous_unspecified():
+    assert query_flange_subtype("Фланец стальной DN80 PN16") is None
+    assert query_flange_subtype("Фланец плоский воротниковый DN80") is None
+
+

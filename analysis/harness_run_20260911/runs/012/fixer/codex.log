+        if _has_any_pattern(text, patterns)
+    ]
+    return matches[0] if len(matches) == 1 else None
+
+
+def candidate_flange_subtype(product: LDProduct) -> str:
+    if candidate_product_type(product) != "flange":
+        return "unknown"
+    text = _product_text(product)
+    matches = [
+        subtype
+        for subtype, patterns in _FLANGE_SUBTYPE_PATTERNS.items()
+        if _has_any_pattern(text, patterns)
+    ]
+    return matches[0] if len(matches) == 1 else "unknown"

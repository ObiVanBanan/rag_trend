     return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
 
 
+def _expand_ball_valve_actuation_intent(text: str) -> str:
+    if not _BALL_VALVE_RE.search(text) or _STANDALONE_ACTUATOR_RE.search(text):
+        return text
+
+    installed = _INSTALLED_ELECTRIC_ACTUATOR_RE.search(text) is not None
+    ready = _ACTUATOR_READY_RE.search(text) is not None
+    if installed == ready:
+        return text
+
+    if ready:
+        return _append_missing_terms(text, ("Под электропривод",))
+    return _append_missing_terms(text, ("Электропривод", "с электроприводом"))
+
+
+def _append_missing_terms(text: str, terms: tuple[str, ...]) -> str:
+    expanded = text
+    for term in terms:
+        if not re.search(rf"(?<!\w){re.escape(term)}(?!\w)", expanded, flags=re.IGNORECASE):
+            expanded = f"{expanded} {term}"
+    return expanded
+
+
 def _normalize_designation_confusables(text: str) -> str:
     def replace(match: re.Match[str]) -> str:
         token = match.group(0)
diff --git a/tests/test_hybrid_retriever.py b/tests/test_hybrid_retriever.py
index a3cdc9ded23e019732e55e465a227e003fcf1602..3cae688deec04f65ed6bafbfeb88e01e37d6fa99
--- a/tests/test_hybrid_retriever.py
+++ b/tests/test_hybrid_retriever.py
@@ -167,3 +167,36 @@
     assert {1, 2, 4}.issubset(by_id)
     assert by_id[1].name == "Original"
     assert by_id[4].name == "Bm25 original"
+
+
+def test_hybrid_search_uses_actuation_state_alternate_without_extra_modality_credit():
+    settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=20, rrf_k=60)
+    embedder = EchoEmbedder()
+    bm25 = VariantBM25Store()
+    retriever = HybridRetriever(embedder, VariantQdrantStore(), bm25, settings)
+    original = "original"
+    canonical = "Кран шаровой DN 50 PN 16 с электроприводом Электропривод"
+
+    results = retriever.search(original, canonical_query=canonical)
+
+    assert embedder.calls == [original, canonical]
+    assert bm25.calls == [(original, 50), (canonical, 50)]
+    by_id = {candidate.ld_id: candidate for candidate in results}
+    assert by_id[2].dense_rank == 2
+    assert by_id[2].bm25_rank == 1
+    assert by_id[2].rrf_score == (1 / 62) + (1 / 61)
+
+
+def test_hybrid_search_keeps_original_actuation_candidates_when_alternate_fails():
+    settings = SimpleNamespace(hybrid_dense_limit=50, hybrid_bm25_limit=50, hybrid_rerank_limit=20, rrf_k=60)
+    retriever = HybridRetriever(EchoEmbedder(), VariantQdrantStore(), VariantBM25Store(fail_on_canonical=True), settings)
+
+    results = retriever.search(
+        "original",
+        canonical_query="canonical",
+    )
+
+    by_id = {candidate.ld_id: candidate for candidate in results}
+    assert {1, 2, 4}.issubset(by_id)
+    assert by_id[1].name == "Original"
+    assert by_id[4].name == "Bm25 original"

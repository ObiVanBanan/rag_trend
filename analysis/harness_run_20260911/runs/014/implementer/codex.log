diff --git a/tests/test_query_canonicalization.py b/tests/test_query_canonicalization.py
index fbcc570a2ce41c6320a6308bf30be1cd4ef51197..c9af753cffc3165b391970595ac080c5a8e2bbae
--- a/tests/test_query_canonicalization.py
+++ b/tests/test_query_canonicalization.py
@@ -52,3 +52,54 @@
 def test_ww_without_supported_product_anchor_does_not_add_welded_vocabulary():
     assert canonicalize_retrieval_query("Поставка WW DN100 PN25").canonical_query == "Поставка WW DN 100 PN 25"
     assert canonicalize_retrieval_query("Насос WW DN100 PN25").canonical_query is None
+
+
+def test_installed_electric_actuator_ball_valve_adds_catalog_state_terms():
+    result = canonicalize_retrieval_query(
+        "Кран шаровой латунный муфт. DN25 PN16 11Б27П1 с электроприводом стандартное исполнение"
+    )
+
+    assert result.source_query == (
+        "Кран шаровой латунный муфт. DN25 PN16 11Б27П1 с электроприводом стандартное исполнение"
+    )
+    assert result.canonical_query == (
+        "Кран шаровой латунный муфтовый DN 25 PN 16 11Б27П1 "
+        "с электроприводом стандартное исполнение Электропривод"
+    )
+
+
+def test_actuator_ready_ball_valve_adds_only_ready_catalog_state_terms():
+    result = canonicalize_retrieval_query(
+        "Кран стальной шаровой фланцевый Ду80 Ру16 11с67п для установки электропривода"
+    )
+
+    assert result.canonical_query == (
+        "Кран стальной шаровой фланцевый DN 80 PN 16 11с67п "
+        "для установки электропривода Под электропривод"
+    )
+    assert "с электроприводом" not in result.canonical_query
+
+
+def test_actuation_state_expansion_retains_explicit_special_execution_without_substitution():
+    result = canonicalize_retrieval_query(
+        "Кран шаровой стальной фланцевый Ду100 Ру25 под электропривод подземное исполнение"
+    )
+
+    assert result.canonical_query == (
+        "Кран шаровой стальной фланцевый DN 100 PN 25 "
+        "под электропривод подземное исполнение"
+    )
+    assert "стандарт" not in result.canonical_query.lower()
+    assert "обычн" not in result.canonical_query.lower()
+    assert "с электроприводом" not in result.canonical_query
+
+
+def test_actuation_state_expansion_requires_explicit_supported_ball_valve_intent():
+    assert canonicalize_retrieval_query("Кран шаровой DN50 PN16 с приводом").canonical_query == "Кран шаровой DN 50 PN 16 с приводом"
+    assert canonicalize_retrieval_query("Кран шаровой DN50 PN16 электрический").canonical_query == "Кран шаровой DN 50 PN 16 электрический"
+    assert canonicalize_retrieval_query("Электропривод для крана шарового DN50 PN16").canonical_query == (
+        "Электропривод для крана шарового DN 50 PN 16"
+    )
+    assert canonicalize_retrieval_query("Клапан DN50 PN16 с электроприводом").canonical_query == (
+        "Клапан DN 50 PN 16 с электроприводом"
+    )


     re.IGNORECASE,
 )
+_BALL_VALVE_RE = re.compile(r"\bкран(?:\s+\S+){0,3}\s+шаровой\b|\bкран\s+шар\b", re.IGNORECASE)
 _UNSUPPORTED_ANCHOR_RE = re.compile(

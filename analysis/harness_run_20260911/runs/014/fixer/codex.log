+def _classify_ball_valve_actuation_state(text: str) -> str | None:
+    ready_spans = [match.span() for match in _ACTUATOR_READY_RE.finditer(text)]
+    has_ready = bool(ready_spans)
+    has_installed = _has_installed_actuator_phrase_outside_spans(text, ready_spans)
+    if has_ready == has_installed:
+        return None
+    return "ready" if has_ready else "installed"
+
+
+def _has_installed_actuator_phrase_outside_spans(text: str, ignored_spans: list[tuple[int, int]]) -> bool:
+    for match in _INSTALLED_ELECTRIC_ACTUATOR_RE.finditer(text):
+        if not any(start <= match.start() and match.end() <= end for start, end in ignored_spans):
+            return True
+    return False
+

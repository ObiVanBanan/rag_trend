    98	def _extract_supported_clause(text: str) -> str:
    99	    anchor = _SUPPORTED_ANCHOR_RE.search(text)
   100	    if not anchor:
   101	        return text
   102	    start = _clause_start(text, anchor.start())
   103	    end = _clause_end(text, anchor.end())
   104	    return text[start:end].strip(" ,;:.")
   105	
   106	
   107	def _clause_start(text: str, anchor_start: int) -> int:
   108	    left = text[:anchor_start]
   109	    matches = list(re.finditer(r"(?:^|[.;])\s*(?:поз\.?\s*)?\d+\s*[-.):]\s*", left, re.IGNORECASE))
   110	    if matches:
   111	        return matches[-1].end()
   112	    punctuation = max(left.rfind(";"), left.rfind("."))
   113	    return punctuation + 1 if punctuation >= 0 else 0
   114	
   115	
   116	def _clause_end(text: str, anchor_end: int) -> int:
   117	    tail = text[anchor_end:]
   118	    stop = re.search(r"(?:[,;]\s*)?(?:кол-?во|количество|шт\.?|ед\.?\s*изм|для\s+закуп|поставка|срок)\b", tail, re.IGNORECASE)
   119	    punctuation_positions = [pos for pos in (tail.find(";"),) if pos >= 0]
   120	    positions = []
   121	    if stop:
   122	        positions.append(stop.start())
   123	    positions.extend(punctuation_positions)
   124	    return anchor_end + min(positions) if positions else len(text)
   125	
   126	
   127	def _strip_quantity_noise(text: str) -> str:
   128	    text = re.sub(r"[,;]?\s*(?:кол-?во|количество)\s*[:\-]?\s*\d+(?:[.,]\d+)?\s*(?:шт\.?|ед\.?)?\b.*$", "", text, flags=re.IGNORECASE)
   129	    text = re.sub(r"[,;]?\s+\d+(?:[.,]\d+)?\s*(?:шт\.?|ед\.?)\s*$", "", text, flags=re.IGNORECASE)
   130	    return text
   131	
   132	
   133	def _normalize_dn_pn(text: str) -> str:
   134	    text = re.sub(r"\bDу\s*[-:]?\s*(\d+)\b", r"DN \1", text, flags=re.IGNORECASE)
   135	    text = re.sub(r"\bDу(\d+)\b", r"DN \1", text, flags=re.IGNORECASE)
   136	    text = re.sub(r"\bДу\s*[-:]?\s*(\d+)\b", r"DN \1", text, flags=re.IGNORECASE)
   137	    text = re.sub(r"\bДу(\d+)\b", r"DN \1", text, flags=re.IGNORECASE)
   138	    text = re.sub(r"\bDN\s*[-:]?\s*(\d+)\b", r"DN \1", text, flags=re.IGNORECASE)
   139	    text = re.sub(r"\bPN\s*[-:]?\s*(\d+(?:[.,]\d+)?)\b", r"PN \1", text, flags=re.IGNORECASE)
   140	    text = re.sub(r"\bРу\s*[-:]?\s*(\d+(?:[.,]\d+)?)\b", r"PN \1", text, flags=re.IGNORECASE)
   141	    text = re.sub(r"\bРу(\d+(?:[.,]\d+)?)\b", r"PN \1", text, flags=re.IGNORECASE)
   142	    return text
   143	
   144	
   145	def _expand_joining_and_actuation(text: str) -> str:
   146	    replacements = (
   147	        (r"(?<!\w)фл\.?(?!\w)", "фланцевый"),
   148	        (r"\bм/ф\b", "муфтовый фланцевый"),
   149	        (r"(?<!\w)муфт\.?(?!\w)", "муфтовый"),
   150	        (r"(?<!\w)резьб\.?(?!\w)", "резьбовой"),
   151	        (r"(?<!\w)эл\.?\s*прив\.?(?!\w)", "электропривод"),
   152	        (r"(?<!\w)прив\.?(?!\w)", "привод"),
   153	        (r"\bэ/п\b", "электропривод"),
   154	    )
   155	    for pattern, replacement in replacements:
   156	        text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)
   157	    return text
   158	
   159	
   160	def _expand_connection_notation(text: str) -> str:
   161	    return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
   162	
   163	
   164	def _expand_ball_valve_actuation_intent(text: str) -> str:
   165	    if not _BALL_VALVE_RE.search(text) or _STANDALONE_ACTUATOR_RE.search(text):
   166	        return text
   167	
   168	    state = _classify_ball_valve_actuation_state(text)
   169	    if state is None:
   170	        return text
   171	
   172	    if state == "ready":
   173	        return _append_missing_terms(text, ("Под электропривод",))
   174	    return _append_missing_terms(text, ("Электропривод", "с электроприводом"))
   175	
   176	
   177	def _classify_ball_valve_actuation_state(text: str) -> str | None:
   178	    ready_spans = [match.span() for match in _ACTUATOR_READY_RE.finditer(text)]
   179	    has_ready = bool(ready_spans)
   180	    has_installed = _has_installed_actuator_phrase_outside_spans(text, ready_spans)
   181	    if has_ready == has_installed:
   182	        return None
   183	    return "ready" if has_ready else "installed"
   184	
   185	
   186	def _has_installed_actuator_phrase_outside_spans(text: str, ignored_spans: list[tuple[int, int]]) -> bool:
   187	    for match in _INSTALLED_ELECTRIC_ACTUATOR_RE.finditer(text):
   188	        if not any(start <= match.start() and match.end() <= end for start, end in ignored_spans):
   189	            return True
   190	    return False
   191	
   192	
   193	def _append_missing_terms(text: str, terms: tuple[str, ...]) -> str:
   194	    expanded = text
   195	    for term in terms:
   196	        if not re.search(rf"(?<!\w){re.escape(term)}(?!\w)", expanded, flags=re.IGNORECASE):
   197	            expanded = f"{expanded} {term}"
   198	    return expanded
   199	
   200	
   201	def _normalize_designation_confusables(text: str) -> str:
   202	    def replace(match: re.Match[str]) -> str:
   203	        token = match.group(0)
   204	        if _CYRILLIC_RE.search(token) and _LATIN_RE.search(token):
   205	            return token.translate(_DESIGNATION_CONFUSABLES)
   206	        return token
   207	
   208	    return _LETTER_DIGIT_RE.sub(replace, text)

    74	def canonicalize_retrieval_query(query: str) -> RetrievalQueryCanonicalization:
    75	    source = " ".join(query.split())
    76	    if not source:
    77	        return RetrievalQueryCanonicalization(source_query="")
    78	
    79	    if _UNSUPPORTED_ANCHOR_RE.search(source) and not _SUPPORTED_ANCHOR_RE.search(source):
    80	        return RetrievalQueryCanonicalization(source_query=source)
    81	
    82	    has_supported_anchor = _SUPPORTED_ANCHOR_RE.search(source) is not None
    83	    canonical = _extract_supported_clause(source)
    84	    canonical = _strip_quantity_noise(canonical)
    85	    canonical = _normalize_dn_pn(canonical)
    86	    canonical = _expand_joining_and_actuation(canonical)
    87	    canonical = _expand_ball_valve_actuation_intent(canonical)
    88	    if has_supported_anchor:
    89	        canonical = _expand_connection_notation(canonical)
    90	    canonical = _normalize_designation_confusables(canonical)
    91	    canonical = _cleanup_spacing(canonical)
    92	
    93	    if canonical == source or not _has_safe_alternate(source, canonical, has_supported_anchor):
    94	        return RetrievalQueryCanonicalization(source_query=source)
    95	    return RetrievalQueryCanonicalization(source_query=source, canonical_query=canonical)

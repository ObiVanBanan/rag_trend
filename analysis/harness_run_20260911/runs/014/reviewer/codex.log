     return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
 
 
+def _expand_ball_valve_actuation_intent(text: str) -> str:
+    if not _BALL_VALVE_RE.search(text) or _STANDALONE_ACTUATOR_RE.search(text):
+        return text
+
+    installed = _INSTALLED_ELECTRIC_ACTUATOR_RE.search(text) is not None
+    ready = _ACTUATOR_READY_RE.search(text) is not None
+    if installed == ready:
+        return text
+
+    if ready:
+        return _append_missing_terms(text, ("Под электропривод",))
+    return _append_missing_terms(text, ("Электропривод", "с электроприводом"))
+
+
+def _append_missing_terms(text: str, terms: tuple[str, ...]) -> str:
+    expanded = text
+    for term in terms:
+        if not re.search(rf"(?<!\w){re.escape(term)}(?!\w)", expanded, flags=re.IGNORECASE):
+            expanded = f"{expanded} {term}"
+    return expanded
+
+
 def _normalize_designation_confusables(text: str) -> str:

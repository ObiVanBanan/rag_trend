+        "Кран шаровой стальной фланцевый Ду100 Ру25 под электропривод подземное исполнение"
+    )
+
+    assert result.canonical_query == (
+        "Кран шаровой стальной фланцевый DN 100 PN 25 "
+        "под электропривод подземное исполнение"
+    )
+    assert "стандарт" not in result.canonical_query.lower()
+    assert "обычн" not in result.canonical_query.lower()
+    assert "с электроприводом" not in result.canonical_query
+
+
+def test_actuation_state_expansion_requires_explicit_supported_ball_valve_intent():
+    assert canonicalize_retrieval_query("Кран шаровой DN50 PN16 с приводом").canonical_query == "Кран шаровой DN 50 PN 16 с приводом"
+    assert canonicalize_retrieval_query("Кран шаровой DN50 PN16 электрический").canonical_query == "Кран шаровой DN 50 PN 16 электрический"
+    assert canonicalize_retrieval_query("Электропривод для крана шарового DN50 PN16").canonical_query == (
+        "Электропривод для крана шарового DN 50 PN 16"
+    )
+    assert canonicalize_retrieval_query("Клапан DN50 PN16 с электроприводом").canonical_query == (
+        "Клапан DN 50 PN 16 с электроприводом"
+    )



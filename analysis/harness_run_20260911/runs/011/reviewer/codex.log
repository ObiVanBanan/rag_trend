+def _append_pipe_od_dn_alternate(text: str) -> str:
+    if _EXPLICIT_DN_RE.search(text):
+        return text
+
+    values = [match.group(1) for match in _MM_DIMENSION_RE.finditer(text)]
+    if len(values) != 1:
+        return text
+
+    od_values: list[int] = []
+    for pattern in _PIPE_OD_CUE_PATTERNS:
+        for match in pattern.finditer(text):
+            parsed = _parse_integral_mm(match.group("value"))
+            if parsed is not None:
+                od_values.append(parsed)
+
+    if len(od_values) != 1:
+        return text
+
+    od = od_values[0]
+    dn = _PIPE_OD_TO_DN.get(od)
+    if dn is None:
+        return text
+
+    if not _has_pipe_od_context(text):
+        return text
+
+    return f"{text} {dn}"
+
+
+def _parse_integral_mm(value: str) -> int | None:
+    normalized = value.replace(",", ".")
+    try:
+        numeric = float(normalized)
+    except ValueError:
+        return None
+    if not numeric.is_integer():
+        return None
+    return int(numeric)
+
+
+def _has_pipe_od_context(text: str) -> bool:
+    return _PIPE_CONTEXT_RE.search(text) is not None
+
+
 def _normalize_designation_confusables(text: str) -> str:

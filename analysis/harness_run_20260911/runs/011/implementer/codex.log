+        "Кран шаровой фланцевый 108 мм PN 16"
+    )
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый d 108 Ру16").canonical_query == (
+        "Кран шаровой фланцевый d 108 PN 16"
+    )
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый d 108 мм L 200 мм Ру16").canonical_query == (
+        "Кран шаровой фланцевый d 108 мм L 200 мм PN 16"
+    )
+
+
+def test_pipe_od_refuses_unsupported_or_no_product_text():
+    assert canonicalize_retrieval_query("Насос фланцевый d 108 мм Ру16").canonical_query is None
+    assert canonicalize_retrieval_query("Поставка наружный диаметр трубы 108 мм").canonical_query is None


diff --git a/tests/test_query_canonicalization.py b/tests/test_query_canonicalization.py
index fbcc570a2ce41c6320a6308bf30be1cd4ef51197..15e947fa72980a2e3e4e3c5609e4898aa5ba06a8
--- a/tests/test_query_canonicalization.py
+++ b/tests/test_query_canonicalization.py
@@ -52,3 +52,49 @@
 def test_ww_without_supported_product_anchor_does_not_add_welded_vocabulary():
     assert canonicalize_retrieval_query("Поставка WW DN100 PN25").canonical_query == "Поставка WW DN 100 PN 25"
     assert canonicalize_retrieval_query("Насос WW DN100 PN25").canonical_query is None
+
+
+def test_pipe_od_d_dimension_adds_source_preserving_dn_alternate():
+    result = canonicalize_retrieval_query("Кран шаровой фл. d 108 мм Ру16 стальной 11с67п")
+
+    assert result.source_query == "Кран шаровой фл. d 108 мм Ру16 стальной 11с67п"
+    assert result.canonical_query == "Кран шаровой фланцевый d 108 мм PN 16 стальной 11с67п DN 100"
+
+
+def test_pipe_od_explicit_outer_diameter_wording_adds_dn_and_keeps_constraints():
+    result = canonicalize_retrieval_query("Задвижка стальная приварная наружный диаметр 108 мм PN25 клиновая")
+
+    assert result.canonical_query == "Задвижка стальная приварная наружный диаметр 108 мм PN 25 клиновая DN 100"
+
+
+def test_pipe_od_pipe_diameter_wording_adds_dn_without_connection_term():
+    result = canonicalize_retrieval_query("Клапан обратный диаметр трубы 108 мм Ру16")
+
+    assert result.canonical_query == "Клапан обратный диаметр трубы 108 мм PN 16 DN 100"
+
+
+def test_pipe_od_refuses_when_explicit_dn_is_present():
+    result = canonicalize_retrieval_query("Кран шаровой фланцевый Ду80 d 108 мм Ру16")
+
+    assert result.canonical_query == "Кран шаровой фланцевый DN 80 d 108 мм PN 16"
+    assert "DN 100" not in result.canonical_query
+
+
+def test_pipe_od_refuses_unmapped_bare_unqualified_and_multiple_dimensions():
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый d 110 мм Ру16").canonical_query == (
+        "Кран шаровой фланцевый d 110 мм PN 16"
+    )
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый 108 мм Ру16").canonical_query == (
+        "Кран шаровой фланцевый 108 мм PN 16"
+    )
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый d 108 Ру16").canonical_query == (
+        "Кран шаровой фланцевый d 108 PN 16"
+    )
+    assert canonicalize_retrieval_query("Кран шаровой фланцевый d 108 мм L 200 мм Ру16").canonical_query == (
+        "Кран шаровой фланцевый d 108 мм L 200 мм PN 16"
+    )
+
+
+def test_pipe_od_refuses_unsupported_or_no_product_text():
+    assert canonicalize_retrieval_query("Насос фланцевый d 108 мм Ру16").canonical_query is None
+    assert canonicalize_retrieval_query("Поставка наружный диаметр трубы 108 мм").canonical_query is None


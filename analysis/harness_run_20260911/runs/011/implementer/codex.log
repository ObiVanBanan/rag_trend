 _STANDALONE_WW_RE = re.compile(r"(?<![A-Za-zА-Яа-яЁё0-9])WW(?![A-Za-zА-Яа-яЁё0-9])", re.IGNORECASE)
+_PIPE_OD_TO_DN = {108: "DN 100"}
+_EXPLICIT_DN_RE = re.compile(r"\bDN\s+\d+\b", re.IGNORECASE)
+_MM_DIMENSION_RE = re.compile(r"(?<!\d)(\d+(?:[.,]\d+)?)\s*(?:мм|mm)\b", re.IGNORECASE)
+_PIPE_CONTEXT_RE = re.compile(
+    r"\b(?:труб\w*|pipe|line|фланц\w*|привар\w*|свар\w*|weld\w*)\b",
+    re.IGNORECASE,
+)
+_PIPE_OD_CUE_PATTERNS = (
+    re.compile(
+        r"\b(?:наружн\w*\s+диаметр|диаметр\s+труб\w*|труб\w*\s+диаметр|pipe\s+od|outer\s+diameter|od)\b"
+        r"[^0-9]{0,24}"
+        r"(?P<value>\d+(?:[.,]\d+)?)\s*(?:мм|mm)\b",
+        re.IGNORECASE,
+    ),
+    re.compile(
+        r"(?<![A-Za-zА-Яа-яЁё0-9])дн\.?\s*[:=\-]?\s*(?P<value>\d+(?:[.,]\d+)?)\s*(?:мм|mm)\b",
+        re.IGNORECASE,
+    ),
+    re.compile(
+        r"(?<![A-Za-zА-Яа-яЁё0-9])[dд]\s*[:=\-]?\s*(?P<value>\d+(?:[.,]\d+)?)\s*(?:мм|mm)\b",
+        re.IGNORECASE,
+    ),
+)
 
 

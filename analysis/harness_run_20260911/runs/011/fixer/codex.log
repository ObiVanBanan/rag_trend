+def test_match_one_hybrid_pipe_od_alternate_preserves_original_query_for_output_and_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран DN100", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.92, reason="od")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Кран шаровой труба d 108 мм Ру16  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+
+    assert result.query == "Кран шаровой труба d 108 мм Ру16"
+    assert hybrid.calls == [
+        (
+            "Кран шаровой труба d 108 мм Ру16",
+            20,
+            "Кран шаровой труба d 108 мм PN 16 DN 100",
+        )
+    ]
+    assert reranker.calls[0][0] == "Кран шаровой труба d 108 мм Ру16"

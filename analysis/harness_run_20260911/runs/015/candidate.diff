+def test_hybrid_search_uses_state_specific_alternate_and_preserves_limits():
+    settings = SimpleNamespace(hybrid_dense_limit=7, hybrid_bm25_limit=8, hybrid_rerank_limit=3, rrf_k=60)
+    embedder = EchoEmbedder()
+    bm25 = VariantBM25Store()
+    retriever = HybridRetriever(embedder, VariantQdrantStore(), bm25, settings)
+    original = "Кран шаровой фланцевый Ду80 Ру16 с эл. прив."
+    canonical = "Кран шаровой фланцевый DN 80 PN 16 с электроприводом электропривод установленный в комплекте"
+
+    results = retriever.search(original, canonical_query=canonical)
+
+    assert embedder.calls == [original, canonical]
+    assert bm25.calls == [(original, 8), (canonical, 8)]
+    assert len(results) == 3
+    assert len({candidate.ld_id for candidate in results}) == len(results)
+

+def test_match_one_hybrid_installed_electric_expansion_preserves_original_query_for_output_and_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран с электроприводом", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.91, reason="state")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Кран шаровой фланцевый Ду80 Ру16 с эл. прив.  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+
+    assert result.query == "Кран шаровой фланцевый Ду80 Ру16 с эл. прив."
+    assert hybrid.calls == [
+        (
+            "Кран шаровой фланцевый Ду80 Ру16 с эл. прив.",
+            20,
+            "Кран шаровой фланцевый DN 80 PN 16 с электроприводом электропривод установленный в комплекте",
+        )
+    ]
+    assert reranker.calls[0][0] == "Кран шаровой фланцевый Ду80 Ру16 с эл. прив."
+
+
+def test_match_one_hybrid_actuator_ready_expansion_preserves_original_query_for_output_and_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран под электропривод", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.91, reason="state")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Кран шаровой фланцевый Ду80 Ру16 под электропривод  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+
+    assert result.query == "Кран шаровой фланцевый Ду80 Ру16 под электропривод"
+    assert hybrid.calls == [
+        (
+            "Кран шаровой фланцевый Ду80 Ру16 под электропривод",
+            20,
+            "Кран шаровой фланцевый DN 80 PN 16 под электропривод подготовка под электропривод без электропривода",
+        )
+    ]
+    assert reranker.calls[0][0] == "Кран шаровой фланцевый Ду80 Ру16 под электропривод"

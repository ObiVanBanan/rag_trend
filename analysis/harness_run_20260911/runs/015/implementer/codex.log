+def _expand_electric_actuation_intent(text: str) -> str:
+    has_installed = _INSTALLED_ELECTRIC_ACTUATION_RE.search(text) is not None
+    has_ready = _ACTUATOR_READY_RE.search(text) is not None
+    if has_installed == has_ready:
+        return text
+    terms = _INSTALLED_ELECTRIC_ACTUATION_TERMS if has_installed else _ACTUATOR_READY_TERMS
+    if terms.lower() in text.lower():
+        return text

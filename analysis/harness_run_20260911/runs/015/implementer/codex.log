     assert canonicalize_retrieval_query("Насос WW DN100 PN25").canonical_query is None
+
+
+def test_installed_electric_actuator_request_adds_state_specific_vocabulary():
+    result = canonicalize_retrieval_query("Кран шаровой фланцевый Ду80 Ру16 с эл. прив.")
+    assert result.source_query == "Кран шаровой фланцевый Ду80 Ру16 с эл. прив."
+    assert (
+        result.canonical_query
+        == "Кран шаровой фланцевый DN 80 PN 16 с электроприводом электропривод установленный в комплекте"
+    )
+
+
+def test_actuator_ready_request_adds_ready_vocabulary_without_installed_state():
+    result = canonicalize_retrieval_query("Кран шаровой фланцевый Ду80 Ру16 под электропривод")
+    assert (
+        result.canonical_query
+        == "Кран шаровой фланцевый DN 80 PN 16 под электропривод подготовка под электропривод без электропривода"
+    )
+    assert "установленный" not in result.canonical_query
+    assert "в комплекте" not in result.canonical_query
+
+
+def test_electric_actuation_state_detection_is_conservative():
+    assert canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 привод ручной").canonical_query == "Кран шаровой DN 80 PN 16 привод ручной"

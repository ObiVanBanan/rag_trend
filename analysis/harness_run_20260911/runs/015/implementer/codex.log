+    r"\bдля\s+электропривода\b|"
+    r"\b(?:подготов(?:лен|ленный|ленная|ленное|ленные|ка)|исполнени[ея])\s+под\s+электропривод\b"
+    r")",
+    re.IGNORECASE,
+)
+_INSTALLED_ELECTRIC_ACTUATION_TERMS = "с электроприводом электропривод установленный в комплекте"

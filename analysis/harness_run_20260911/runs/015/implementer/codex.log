diff --git a/tests/test_matcher.py b/tests/test_matcher.py
index 3756a80765e09a5ca5fb6258fce81ee6de297695..5e3e97f5bb9f0c226b9e38795c8b4f8c4f0be895
--- a/tests/test_matcher.py

diff --git a/tests/test_query_canonicalization.py b/tests/test_query_canonicalization.py
index fbcc570a2ce41c6320a6308bf30be1cd4ef51197..afd9c9edac29ae6f6823292bbe5ae87dc7fd6ec9
--- a/tests/test_query_canonicalization.py
+++ b/tests/test_query_canonicalization.py
@@ -52,3 +52,37 @@
 def test_ww_without_supported_product_anchor_does_not_add_welded_vocabulary():
     assert canonicalize_retrieval_query("Поставка WW DN100 PN25").canonical_query == "Поставка WW DN 100 PN 25"
     assert canonicalize_retrieval_query("Насос WW DN100 PN25").canonical_query is None
+
+
+def test_installed_electric_actuator_request_adds_state_specific_vocabulary():
+    result = canonicalize_retrieval_query("Кран шаровой фланцевый Ду80 Ру16 с эл. прив.")
+    assert result.source_query == "Кран шаровой фланцевый Ду80 Ру16 с эл. прив."
+    assert (
+        result.canonical_query
+        == "Кран шаровой фланцевый DN 80 PN 16 с электроприводом электропривод установленный в комплекте"
+    )
+
+
+def test_actuator_ready_request_adds_ready_vocabulary_without_installed_state():
+    result = canonicalize_retrieval_query("Кран шаровой фланцевый Ду80 Ру16 под электропривод")
+    assert (
+        result.canonical_query
+        == "Кран шаровой фланцевый DN 80 PN 16 под электропривод подготовка под электропривод без электропривода"
+    )
+    assert "установленный" not in result.canonical_query
+    assert "в комплекте" not in result.canonical_query
+
+
+def test_electric_actuation_state_detection_is_conservative():
+    assert canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 привод ручной").canonical_query == "Кран шаровой DN 80 PN 16 привод ручной"
+    assert canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 электро").canonical_query == "Кран шаровой DN 80 PN 16 электро"
+    assert canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 с пневмоприводом").canonical_query == "Кран шаровой DN 80 PN 16 с пневмоприводом"
+    assert (
+        canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 с суперэлектроприводом").canonical_query
+        == "Кран шаровой DN 80 PN 16 с суперэлектроприводом"
+    )
+    assert (
+        canonicalize_retrieval_query("Кран шаровой Ду80 Ру16 с электроприводом под электропривод").canonical_query
+        == "Кран шаровой DN 80 PN 16 с электроприводом под электропривод"
+    )
+    assert canonicalize_retrieval_query("Насос Ду80 Ру16 с электроприводом").canonical_query is None


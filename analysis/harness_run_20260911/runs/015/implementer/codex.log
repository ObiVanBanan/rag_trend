+    r"\b(?:оснащ[её]н(?:ный|ная|ное|ные)?|укомплектован(?:ный|ная|ное|ные)?|комплекту(?:е|ю)тся)\s+электроприводом\b|"
+    r"\bэлектропривод\s+в\s+комплекте\b"

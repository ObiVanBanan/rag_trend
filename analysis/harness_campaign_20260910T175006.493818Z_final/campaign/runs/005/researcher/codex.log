import gzip,json,re
D='data/'
def L(n):
 with gzip.open(D+n,'rt',encoding='utf8') as f:return json.load(f)
A=L('tender_queries_kontur_5files.json.gz'); G=L('tender_queries_kontur_5files_labels_gold_v1.json.gz'); P=L('tender_queries_kontur_5files_provisional_not_found.json.gz'); R=[x for x in A if x['id'] not in G and x['id'] not in {p['id'] for p in P}]
anchors=re.compile(r'\\b(?:кран\\w*|затвор\\w*|задвиж\\w*|клапан\\w*|вентил\\w*|фильтр\\w*|фланец\\w*|муфт\\w*|сгон\\w*|переход\\w*|тройник\\w*|отвод\\w*)',re.I)
rows=[]
for x in R:
 a=anchors.findall(x['query'])
 if len(a)>=2 and (re.search(r'[;()]|\\s[—-]\\s|\\bи\\b',x['query'],re.I)):
  rows.append((len(a),x['query']))
print(len(rows),'potential multiple product/work anchors')
for _,q in rows[:12]:print(q)

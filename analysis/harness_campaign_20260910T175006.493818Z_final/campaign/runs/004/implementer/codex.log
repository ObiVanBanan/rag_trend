@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import re
+
+
+NO_CATALOG_EVIDENCE = "NO_CATALOG_EVIDENCE"
+
+_VALVE_OR_FITTING_RE = re.compile(
+    r"\b("
+    r"кран(?:\s+шаровой)?|клапан|задвижка|затвор|вентиль|"
+    r"фланец|муфта|переход|тройник|отвод|ниппель|штуцер|фитинг"
+    r")\b",
+    re.IGNORECASE,
+)
+_MECHANICAL_FILTER_RE = re.compile(
+    r"\b(фильтр\s+(?:сетчат|грязев|механическ|магистральн)|фильтр\s+муфтов|фильтр\s+фланцев)\w*",
+    re.IGNORECASE,
+)
+_FILTER_RE = re.compile(r"\bфильтр\w*\b", re.IGNORECASE)
+_ELEMENT_RE = re.compile(
+    r"\b(картридж\w*|кассет\w*|элемент\w*|патрон\w*|модул\w*|сменн\w*|запасн\w*|расходн\w*)\b",
+    re.IGNORECASE,
+)
+_MEDIA_RE = re.compile(
+    r"\b(загрузк\w*|сорбент\w*|смол\w*|угол[ья]\w*|кварцев\w*\s+пес\w*|фильтрующ\w*\s+материал\w*)\b",
+    re.IGNORECASE,
+)
+_WATER_TREATMENT_RE = re.compile(
+    r"\b(водоочистк\w*|водоподготовк\w*|умягчен\w*|обезжелезиван\w*|обессоливан\w*|ионообмен\w*|обратн\w*\s+осмос\w*)\b",
+    re.IGNORECASE,
+)
+_SYSTEM_RE = re.compile(r"\b(систем\w*|установк\w*|станци\w*)\b", re.IGNORECASE)
+_SERVICE_RE = re.compile(
+    r"\b(монтаж\w*|демонтаж\w*|ремонт\w*|обслуживан\w*|замен\w*|пусконалад\w*|работ\w*|услуг\w*)\b",
+    re.IGNORECASE,
+)
+_PRODUCT_NOUN_RE = re.compile(
+    r"\b(поставка|приобретен\w*|закупк\w*|изготовлен\w*|издели\w*|комплект\w*|оборудовани\w*|запчаст\w*)\b",
+    re.IGNORECASE,
+)
+
+
+def classify_catalog_scope(query: str) -> str | None:
+    text = " ".join(query.split())
+    if not text:
+        return None
+    if _has_sellable_product_cue(text):
+        return None
+    if _is_filter_consumable_or_media(text):
+        return NO_CATALOG_EVIDENCE
+    if _is_water_treatment_request(text):
+        return NO_CATALOG_EVIDENCE
+    if _is_service_only_request(text):
+        return NO_CATALOG_EVIDENCE
+    return None
+
+
+def _has_sellable_product_cue(text: str) -> bool:
+    return bool(_VALVE_OR_FITTING_RE.search(text) or _MECHANICAL_FILTER_RE.search(text))
+
+
+def _is_filter_consumable_or_media(text: str) -> bool:
+    has_filter_context = _FILTER_RE.search(text) or _WATER_TREATMENT_RE.search(text)
+    return bool((has_filter_context and _ELEMENT_RE.search(text)) or _MEDIA_RE.search(text))
+
+
+def _is_water_treatment_request(text: str) -> bool:
+    return bool(_WATER_TREATMENT_RE.search(text) and (_MEDIA_RE.search(text) or _SYSTEM_RE.search(text)))
+
+
+def _is_service_only_request(text: str) -> bool:
+    if not _SERVICE_RE.search(text):
+        return False
+    if _PRODUCT_NOUN_RE.search(text):
+        return False
+    return bool(_WATER_TREATMENT_RE.search(text) or (_FILTER_RE.search(text) and _ELEMENT_RE.search(text)))

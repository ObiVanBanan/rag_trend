+def test_match_one_hybrid_routes_no_catalog_evidence_before_retrieval_or_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    reranker = Reranker(result=SimpleNamespace(status="MATCHED", selected=[], reason=None))
+    hybrid = HybridRetriever([SearchCandidate(ld_id=1, name="A", article="A1", score=0.01)])
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+
+    result = matcher.match_one_hybrid_with_rerank("  Картридж сменный для фильтра водоочистки  ")
+
+    assert result.query == "Картридж сменный для фильтра водоочистки"
+    assert result.status == "NOT_FOUND"
+    assert result.reason == NO_CATALOG_EVIDENCE
+    assert result.ld_product is None
+    assert result.candidates == []
+    assert result.selected == []
+    assert hybrid.calls == []
+    assert reranker.calls == []
+
+

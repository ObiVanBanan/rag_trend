diff --git a/tests/test_catalog_scope.py b/tests/test_catalog_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..a30b19561bc512eb6fab20b78c33ace614df748f
--- /dev/null
+++ b/tests/test_catalog_scope.py
@@ -0,0 +1,34 @@
+from nomenclature_matcher.catalog_scope import NO_CATALOG_EVIDENCE, classify_catalog_scope
+
+
+def test_consumable_filter_request_has_no_catalog_evidence():
+    assert classify_catalog_scope("Картридж сменный для фильтра тонкой очистки 10 мкм") == NO_CATALOG_EVIDENCE
+
+
+def test_filtration_media_request_has_no_catalog_evidence():
+    assert classify_catalog_scope("Фильтрующий материал кварцевый песок для установки очистки воды") == NO_CATALOG_EVIDENCE
+
+
+def test_water_treatment_system_has_no_catalog_evidence():
+    assert classify_catalog_scope("Система водоподготовки обратного осмоса производительность 2 м3/ч") == NO_CATALOG_EVIDENCE
+
+
+def test_service_only_supported_scope_has_no_catalog_evidence():
+    assert classify_catalog_scope("Обслуживание системы водоочистки и замена картриджей") == NO_CATALOG_EVIDENCE
+
+
+def test_generic_filter_fails_open():
+    assert classify_catalog_scope("Фильтр DN25 PN16") is None
+
+
+def test_unknown_vendor_and_model_fail_open():
+    assert classify_catalog_scope("Фильтр AquaVendor ZX-9000") is None
+
+
+def test_action_verb_alone_fails_open():
+    assert classify_catalog_scope("Монтаж и демонтаж оборудования") is None
+
+
+def test_service_text_with_valve_or_fitting_fails_open():
+    assert classify_catalog_scope("Замена крана шарового DN50 PN16") is None
+    assert classify_catalog_scope("Ремонт муфты переходной DN40") is None

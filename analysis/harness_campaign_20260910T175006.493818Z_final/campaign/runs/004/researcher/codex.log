import gzip,json,re
with gzip.open('data/tender_queries_kontur_5files.json.gz','rt',encoding='utf8') as f: all_rows=json.load(f)
with gzip.open('data/tender_queries_kontur_5files_labels_gold_v1.json.gz','rt',encoding='utf8') as f: labels=json.load(f)
with gzip.open('data/tender_queries_kontur_5files_provisional_not_found.json.gz','rt',encoding='utf8') as f: provisional=json.load(f)
review=[x for x in all_rows if x['id'] not in labels and x['id'] not in {q['id'] for q in provisional}]
anchors=re.compile(r'\\b(?:кран|затвор|задвижк\\w*|клапан|вентил\\w*|фильтр|фланец|муфта|сгон|переход|тройник|отвод)\\w*',re.I)
compound=[]
for x in review:
  tokens=anchors.findall(x['query'])
  types={t.lower().rstrip('ыаов') for t in tokens}
  if (';' in x['query'] or '(' in x['query'] or len(tokens)>=3) and len(tokens)>=2: compound.append((x['query'],tokens))
print('potential compound',len(compound))
for text,tokens in compound[:18]: print(tokens,'--',text)
# exact current canonical examples of 40 sorted source shorter
a=[]
from nomenclature_matcher.query_canonicalization import canonicalize_retrieval_query
for x in review:
 c=canonicalize_retrieval_query(x['query']).canonical_query
 if c: a.append((x['query'],c))
print('alternates that lose material query length >15')
for q,c in a:
 if len(q)-len(c)>15: print(len(q),len(c),'--',q,'=>',c)

--- a/src/nomenclature_matcher/query_canonicalization.py
+++ b/src/nomenclature_matcher/query_canonicalization.py
@@ -36,6 +36,25 @@ _SUPPORTED_ANCHOR_RE = re.compile(
     r"\b(кран(?:\s+шаровой)?|клапан|задвижка|затвор|вентиль|фильтр|регулятор|фланец|муфта|переход|тройник|отвод)\b",
     re.IGNORECASE,
 )
+_BALL_VALVE_RE = re.compile(r"\b(?:кран\s+шаровой|шаровой\s+кран)\b", re.IGNORECASE)
+_STANDARD_BORE_CONTEXT_RE = re.compile(
+    r"\b(?:"
+    r"стандартн(?:ое|ого|ом|ым|ый|ого)?\s+исполнен(?:ие|ия|ии|ием)|"
+    r"исполнен(?:ие|ия|ии|ием)\s+стандартн(?:ое|ого|ом|ым)|"
+    r"стандартн(?:ый|ого|ом|ым)\s+проход|"
+    r"стандартно\s*проходн\w*|"
+    r"стандартнопроходн\w*"
+    r")\b",
+    re.IGNORECASE,
+)
+_CONFLICTING_BORE_RE = re.compile(
+    r"\b(?:"
+    r"полнопроходн\w*|полно\s*проходн\w*|полн(?:ый|ого|ом|ым)\s+проход|"
+    r"редуцированн\w*|неполнопроходн\w*|неполно\s*проходн\w*|суженн\w*\s+проход"
+    r")\b",
+    re.IGNORECASE,
+)
+_STANDARD_BORE_TERMS = ("стандартнопроходной", "стандартный проход")
 _UNSUPPORTED_ANCHOR_RE = re.compile(
     r"\b(насос|двигател|кабель|датчик|счетчик|сч[её]тчик|подшипник|болт|гайка|шайба)\b",
     re.IGNORECASE,
@@ -64,6 +83,7 @@ def canonicalize_retrieval_query(query: str) -> RetrievalQueryCanonicalization:
     canonical = _expand_joining_and_actuation(canonical)
     if has_supported_anchor:
         canonical = _expand_connection_notation(canonical)
+    canonical = _expand_standard_bore(canonical)
     canonical = _normalize_designation_confusables(canonical)
     canonical = _cleanup_spacing(canonical)
 
@@ -138,6 +158,19 @@ def _expand_connection_notation(text: str) -> str:
     return _STANDALONE_WW_RE.sub("WW приварной под приварку сварной", text)
 
 
+def _expand_standard_bore(text: str) -> str:
+    if not _BALL_VALVE_RE.search(text):
+        return text
+    if not _STANDARD_BORE_CONTEXT_RE.search(text):
+        return text
+    if _CONFLICTING_BORE_RE.search(text):
+        return text
+    additions = [term for term in _STANDARD_BORE_TERMS if not re.search(rf"\b{term}\b", text, re.IGNORECASE)]
+    if not additions:
+        return text
+    return f"{text} {' '.join(additions)}"
+
+
 def _normalize_designation_confusables(text: str) -> str:
     def replace(match: re.Match[str]) -> str:
         token = match.group(0)

+def test_match_one_hybrid_standard_bore_expansion_preserves_original_query_for_output_and_rerank():
+    settings = SimpleNamespace(
+        match_top_k=5,
+        match_score_threshold=0.8,
+        rerank_candidate_limit=20,
+        hybrid_rerank_limit=20,
+    )
+    candidates = [SearchCandidate(ld_id=1, name="Кран стандартнопроходной", article="A1", score=0.01)]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.91, reason="standard")], reason=None)
+    reranker = Reranker(result=rerank_result)
+    hybrid = HybridRetriever(candidates)
+    matcher = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=reranker, hybrid_retriever=hybrid)
+    query = "  Кран шаровой стандартное исполнение DN80 PN16  "
+
+    result = matcher.match_one_hybrid_with_rerank(query)
+    payload = match_result_payload(result)
+
+    assert result.query == "Кран шаровой стандартное исполнение DN80 PN16"
+    assert payload["query"] == "Кран шаровой стандартное исполнение DN80 PN16"
+    assert hybrid.calls == [
+        (
+            "Кран шаровой стандартное исполнение DN80 PN16",
+            20,
+            "Кран шаровой стандартное исполнение DN 80 PN 16 стандартнопроходной стандартный проход",
+        )
+    ]
+    assert reranker.calls[0][0] == "Кран шаровой стандартное исполнение DN80 PN16"

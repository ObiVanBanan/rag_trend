+def search_candidate(ld_id, name, *, score=0.01, properties=None):
+    return SearchCandidate(
+        ld_id=ld_id,
+        name=name,
+        article=f"A{ld_id}",
+        score=score,
+        properties=properties or [{"name": "Тип продукта", "values": ["Кран шаровый"]}],
+        rrf_score=score,
+    )
+
+
+def test_post_rerank_fallback_replaces_ordinary_query_underground_choice():
+    settings = SimpleNamespace(match_top_k=5, match_score_threshold=0.8, rerank_candidate_limit=20)
+    candidates = [
+        search_candidate(1, "Кран шаровый LD подземный полнопроходной ручное управление", score=0.03),
+        search_candidate(2, "Кран шаровый LD фланцевый полнопроходной ручное управление", score=0.02),
+    ]
+    rerank_result = SimpleNamespace(status="MATCHED", selected=[SimpleNamespace(candidate_id=1, confidence=0.93, reason="best")], reason=None)
+
+    result = NomenclatureMatcher(Embedder(), Store([]), settings, reranker=Reranker(result=rerank_result)).rerank_candidates(
+        "Кран шаровой фланцевый полнопроходной",
+        candidates,
+    )
+
+    assert result.ld_product == candidates[1]
+    assert result.selected[0].ld_id == 2
+    assert result.selected[0].selection_source == "compatibility_fallback"
+    assert result.selection_source == "compatibility_fallback"

+def resolve_selection_requirements(query: str) -> SelectionRequirements:
+    value = _norm(query)
+    is_ball_valve = "кран" in value and "шар" in value
+    valve_type = None
+    if is_ball_valve:
+        special = (
+            ("underground", ("подзем",)),
+            ("regulating", ("регулиру", "regula")),
+            ("cryogenic", ("криоген",)),
+            ("gas", ("газов", "для газа")),
+        )
+        for resolved, phrases in special:
+            if any(phrase in value for phrase in phrases):
+                valve_type = resolved
+                break
+        if valve_type is None:
+            valve_type = "standard"
+
+    control = None
+    if "под электропривод" in value:
+        control = "electric_ready"
+    elif "электропривод" in value:
+        control = "electric"
+
+    bore_type = canonical_bore_type(value)
+    return SelectionRequirements(valve_type=valve_type, control=control, bore_type=bore_type)
+
+
+def verifiable_candidate_control(product: LDProduct) -> str | None:
+    for value in [*_property_values(product, "Управление"), product.name]:
+        result = canonical_control(value)
+        if result:
+            return result
+    return None
+
+
+def verifiable_candidate_bore_type(product: LDProduct) -> str | None:
+    return candidate_bore_type(product)
+
+
+def verifiable_candidate_valve_type(product: LDProduct) -> str | None:
+    if candidate_product_type(product) != "ball_valve":
+        return None
+    return candidate_valve_type(product)
+
+
+def evaluate_selection_compatibility(
+    product: LDProduct,
+    requirements: SelectionRequirements,
+) -> SelectionCompatibility:
+    satisfied: dict[str, str] = {}
+    contradicted: dict[str, str] = {}
+    unknown: dict[str, str] = {}
+
+    checks = (
+        ("valve_type", requirements.valve_type, verifiable_candidate_valve_type(product)),
+        ("control", requirements.control, verifiable_candidate_control(product)),
+        ("bore_type", requirements.bore_type, verifiable_candidate_bore_type(product)),
+    )
+    for field_name, expected, actual in checks:
+        if expected is None:
+            continue
+        detail = f"{actual} == {expected}"
+        if actual is None:
+            unknown[field_name] = detail
+        elif actual == expected:
+            satisfied[field_name] = detail
+        else:
+            contradicted[field_name] = detail
+    return SelectionCompatibility(satisfied=satisfied, contradicted=contradicted, unknown=unknown)
+
+
 def candidate_valve_type(product: LDProduct) -> str | None:
     if candidate_product_type(product) != "ball_valve":
         return None

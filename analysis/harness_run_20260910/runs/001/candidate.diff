+        dn="50",
+        pn="16",
+        joining_type="Фланцевое",
+        properties=[
+            {"name": "Тип продукта", "values": ["Кран шаровый"]},
+            {"name": "Управление", "values": ["Под электропривод"]},
+        ],
+    )
+    contradictory = SearchCandidate(
+        ld_id=2,
+        name="Кран шаровый муфтовый DN50 PN16 ручной",
+        article="A-2",
+        score=0.9,
+        dn="50",
+        pn="16",
+        joining_type="Муфтовое",
+        properties=[{"name": "Тип продукта", "values": ["Кран шаровый"]}],
+    )
+    missing = SearchCandidate(ld_id=3, name="", article=None, score=0.8)
+    req = constraints(dn=50, joining_type="flanged", control="electric_ready", pn_min_mpa=1.6)
+
+    assert evaluate_candidate_compatibility(compatible, req).status == "compatible"
+
+    mismatch = evaluate_candidate_compatibility(contradictory, req)
+    assert mismatch.status == "contradictory"
+    assert "joining_type" in mismatch.contradictory_fields
+    assert "control" in mismatch.contradictory_fields
+
+    unknown = evaluate_candidate_compatibility(missing, req)
+    assert unknown.status == "unverifiable"
+    assert "dn" in unknown.unverifiable_fields
+    assert "joining_type" in unknown.unverifiable_fields

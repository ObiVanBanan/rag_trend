+    def _extract_constraint_gate(self, query: str) -> tuple[object | None, ConstraintGateDiagnostics | None]:
+        if self.constraint_extractor is None:
+            return None, None
+        try:
+            constraints = self.constraint_extractor.extract(query)
+        except Exception as exc:
+            return None, ConstraintGateDiagnostics(applied=False, fallback_reason=f"extractor_failed: {exc}")
+        diagnostics = ConstraintGateDiagnostics(
+            applied=False,
+            constraints=constraint_summary(constraints),
+        )
+        if constraints.ambiguous:
+            diagnostics.fallback_reason = "ambiguous_constraints"
+            return None, diagnostics
+        if constraints.catalog_scope == "out_of_scope":
+            diagnostics.abstention_reason = "out_of_scope"
+            return constraints, diagnostics
+        if constraints.catalog_scope != "in_scope":
+            diagnostics.fallback_reason = f"catalog_scope_{constraints.catalog_scope}"
+            return None, diagnostics
+        if not constraints_are_gate_eligible(constraints):
+            diagnostics.fallback_reason = "no_usable_constraints"
+            return None, diagnostics
+        diagnostics.applied = True
+        return constraints, diagnostics
